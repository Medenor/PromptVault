{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "@playwright/test"],
    "exactOptionalPropertyTypes": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["scripts/**/*.ts", "playwright.config.ts", "tests/accessibility/**/*.ts"],
  "exclude": ["tests/accessibility/**/*.spec.ts", "tests/accessibility/sample-test.example.ts"]
}
