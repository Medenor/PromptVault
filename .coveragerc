[run]
source = src
omit =
    # Database-backed backup service (integration-heavy, covered by E2E)
    */services/backup_service_db.py
    # Legacy/unused prompt filters
    */services/prompt_filter_service.py
    # Database health checks (not critical for core functionality)
    */db/health.py
    # Response model shims
    */web/models/prompt_responses.py

[report]
exclude_lines =
    # Standard exclusions
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
