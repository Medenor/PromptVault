  "narrative": {
    "northStar": "The Quiet Archive",
    "overview": "PromptVault looks like a well-kept library: flat, legible, and unhurried. Content leads. Chrome recedes. One blue marks what you can act on.",
    "keyCharacteristics": [
      "Flat surfaces separated by hairline borders and tonal fills, not shadows.",
      "One action color (blue); green marks skills and success, amber marks secondary emphasis and warnings.",
      "One typeface in five weights.",
      "Visible, high-contrast keyboard focus everywhere.",
      "Light and dark parity."
    ],
    "rules": [
      {
        "name": "The One Voice Rule",
        "body": "Blue means action. Do not use blue as decoration, as a section color, or for large fills outside primary buttons and active states.",
        "section": "colors"
      },
      {
        "name": "The Contrast Floor Rule",
        "body": "Text and interactive boundaries meet WCAG 2.1 AA. Reach for the 700 step on light backgrounds, not the 500 step.",
        "section": "colors"
      },
      {
        "name": "The Single Family Rule",
        "body": "Outfit only. Never introduce a second typeface for emphasis.",
        "section": "typography"
      },
      {
        "name": "The 16px Input Rule",
        "body": "Form controls stay at 16px so mobile browsers do not zoom on focus.",
        "section": "typography"
      },
      {
        "name": "The Overlay-Only Shadow Rule",
        "body": "A shadow means this sits above the page. Do not put shadows on resting cards, inputs, or buttons.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use Action Blue (#1d4ed8) for the single primary action in a view.",
      "Do keep surfaces flat; separate them with hairline borders and tonal fills.",
      "Do use focus-visible styling and the 3px Focus Blue outline on every interactive element.",
      "Do ship every new UI string through i18n and check it in light and dark mode.",
      "Do reuse the components in src/web/static/ts/components/ before writing new markup."
    ],
    "donts": [
      "Don't add shadows to resting cards, inputs or buttons.",
      "Don't use primary-500 blue (#3b82f6) for white-on-blue text; it misses contrast.",
      "Don't introduce a second typeface or a new accent hue.",
      "Don't use custom CSS where a Tailwind utility exists.",
      "Don't signal state with color alone."
    ]
  }
