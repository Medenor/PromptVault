# PromptVault Environment Configuration
# Copy this file to .env and adjust values for your environment
#
# Running with Docker Compose? Compose reads the .env next to docker-compose.yml
# and passes ENVIRONMENT, LOG_LEVEL, DISABLE_RATE_LIMITING, POSTGRES_PASSWORD, the
# JWT_*_EXPIRE_SECONDS values, DOCS_APP_URL and VITE_DOCS_PORTAL_URL into the
# containers. Everything else here (including DATABASE_URL, which compose sets itself)
# is only used when you run the app directly on the host.
# So a development .env also configures a production stack started from the same
# directory. For production, keep a separate file and pass it explicitly:
#   cp .env .env.production      # then edit it (see "Production" below); it is gitignored
#   docker-compose --env-file .env.production up -d

# =============================================================================
# Database Configuration
# =============================================================================

# Database connection URL
# Options:
#   - SQLite (Development/Testing): sqlite:///./data-dev/promptvault.db
#   - PostgreSQL (Production): postgresql://username:password@localhost:5432/promptvault
#
# Default: SQLite at ./data-dev/promptvault.db
DATABASE_URL=sqlite:///./data-dev/promptvault.db

# PostgreSQL Connection Pool Settings (ignored for SQLite)
# Number of connections to maintain in the pool
DB_POOL_SIZE=20

# Connection pool timeout in seconds
DB_POOL_TIMEOUT=30

# Time in seconds before recycling a connection (prevents stale connections)
DB_POOL_RECYCLE=3600

# Enable SQL query logging (useful for debugging, disable in production)
# Set to true to see all SQL queries in logs
DB_ECHO=false

# =============================================================================
# Application Settings
# =============================================================================

# Environment: development, testing, production
# (set to production in .env.production; see the note at the top of this file)
ENVIRONMENT=development

# Directory for data files, backups, and logs. Keep this distinct per
# environment (dev/staging/prod) even when they share a host/filesystem,
# otherwise scheduled backups and restores can silently collide.
PROMPTVAULT_DATA_DIR=./data-dev

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Audit log level (for version control and backup operations)
AUDIT_LOG_LEVEL=INFO

# Turns rate limiting off (development and testing only). Never true in production:
# Docker Compose passes this variable to the container, so a development .env that
# sets it to true disables login throttling on the server too.
# DISABLE_RATE_LIMITING=false

# =============================================================================
# Authentication & Security Configuration
# =============================================================================

# Authentication Toggle
# Enable or disable the authentication subsystem entirely.
# Set to false for anonymous/local mode where no login is required and all
# endpoints are publicly accessible.
# WARNING: Only use AUTH_ENABLED=false in a trusted, single-user environment.
# Do NOT use this mode in multi-user or network-exposed deployments.
AUTH_ENABLED=true

# JWT Configuration
# Path to ES256 private key for signing tokens
JWT_PRIVATE_KEY_PATH=secrets/jwt/private_key.pem

# Path to ES256 public key for verifying tokens
JWT_PUBLIC_KEY_PATH=secrets/jwt/public_key.pem

# JWT token lifetimes (in seconds)
# Access token: Short-lived, used for API requests (15 minutes = 900s)
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=900

# Refresh token: Longer-lived, used to get new access tokens (7 days = 604800s)
JWT_REFRESH_TOKEN_EXPIRE_SECONDS=604800

# JWT token issuer and audience (for token validation)
JWT_ISSUER=promptvault
JWT_AUDIENCE=promptvault-api

# TOTP 2FA Configuration
# Server-held symmetric key used to derive the AES-256-GCM key that encrypts
# TOTP secrets at rest. Required when any user enables 2FA. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TOTP_ENCRYPTION_KEY=

# Password Policy
# Minimum password length
PASSWORD_MIN_LENGTH=12

# Require uppercase letter in password
PASSWORD_REQUIRE_UPPERCASE=true

# Require lowercase letter in password
PASSWORD_REQUIRE_LOWERCASE=true

# Require digit in password
PASSWORD_REQUIRE_DIGIT=true

# Require special character in password (!@#$%^&*()_+-=[]{}|;:,.<>?)
PASSWORD_REQUIRE_SPECIAL=true

# Account Security
# Maximum failed login attempts before account lockout
MAX_LOGIN_ATTEMPTS=5

# Account lockout duration in seconds (15 minutes = 900s)
ACCOUNT_LOCKOUT_DURATION_SECONDS=900

# Session Management
# Maximum number of active sessions per user (0 = unlimited)
MAX_SESSIONS_PER_USER=5

# Inactive session timeout in seconds (30 days = 2592000s)
SESSION_INACTIVE_TIMEOUT_SECONDS=2592000

# Rate Limiting
# Redis connection URL for rate limiting storage
REDIS_URL=redis://localhost:6379/0

# Login rate limit: attempts per time window
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900

# Registration rate limit: attempts per time window
RATE_LIMIT_REGISTER_ATTEMPTS=3
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600

# Password reset rate limit: attempts per time window
RATE_LIMIT_PASSWORD_RESET_ATTEMPTS=3
RATE_LIMIT_PASSWORD_RESET_WINDOW_SECONDS=3600

# General API rate-limit taxonomy (per-user, falling back to IP).
# Applied to state-changing and expensive endpoints beyond auth. Each bucket is
# attempts-per-window; tune down in shared/multi-user deployments if needed.
# Read endpoints (GET) — generous:
RATE_LIMIT_READ_ATTEMPTS=300
RATE_LIMIT_READ_WINDOW_SECONDS=60
# Write endpoints (create/update/delete/revert):
RATE_LIMIT_WRITE_ATTEMPTS=60
RATE_LIMIT_WRITE_WINDOW_SECONDS=60
# Expensive ops (import/export, backup create/restore/verify):
RATE_LIMIT_EXPENSIVE_ATTEMPTS=10
RATE_LIMIT_EXPENSIVE_WINDOW_SECONDS=60
# Bulk ops (bulk delete, delete-all backups, compress):
RATE_LIMIT_BULK_ATTEMPTS=5
RATE_LIMIT_BULK_WINDOW_SECONDS=60

# Email Configuration (for password reset)
# SMTP server settings
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=changeme

# Email sender information
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=PromptVault

# Password reset token validity (1 hour = 3600s)
PASSWORD_RESET_TOKEN_EXPIRE_SECONDS=3600

# Application URLs (for password reset emails)
# Base URL of the application
APP_BASE_URL=http://localhost:7870

# =============================================================================
# Dev Server Ports (used by `make dev`; BACKEND_PORT is passed through as PORT)
# =============================================================================
BACKEND_PORT=7870
FRONTEND_PORT=7873

# =============================================================================
# Backup Configuration
# =============================================================================

# Passphrase used to encrypt cloud storage provider credentials (access key /
# secret key) at rest in the database. REQUIRED to use cloud backup storage —
# the app will refuse to create or access providers if this is not set.
# Set this to a long, random string unique to your installation.
# Never share it or commit it to source control.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# PROMPTVAULT_CLOUD_CREDS_PASSPHRASE=

# =============================================================================
# Skill Package Limits
# =============================================================================
# Limits applied to skill .zip uploads. Archive entries are read in memory and
# never extracted to disk. All values are optional; defaults are shown.

# Largest accepted .zip upload (bytes, default 10 MB)
# SKILL_MAX_UPLOAD_BYTES=10485760
# Largest total unpacked size of one skill (bytes, default 50 MB)
# SKILL_MAX_TOTAL_BYTES=52428800
# Largest number of files in one skill
# SKILL_MAX_FILES=500
# Deepest folder nesting below the skill root
# SKILL_MAX_DEPTH=10
# Largest single unpacked file (bytes, default 10 MB)
# SKILL_MAX_FILE_BYTES=10485760
# Highest compression ratio accepted for an entry over 1 MB (zip-bomb defence)
# SKILL_MAX_COMPRESSION_RATIO=100
# Largest text excerpt shown in the file viewer (bytes, default 1 MB)
# SKILL_TEXT_PREVIEW_BYTES=1048576
# Largest accepted SKILL.md (bytes, default 1 MB)
# SKILL_MAX_SKILL_MD_BYTES=1048576

# =============================================================================
# Example Configurations
# =============================================================================

# Example: PostgreSQL Production Configuration
# A plain postgresql:// URL uses the psycopg v3 driver. The older
# postgresql+psycopg2:// form is still accepted and mapped to it.
# DATABASE_URL=postgresql://promptvault_user:secure_password@localhost:5432/promptvault_prod
# DB_POOL_SIZE=30
# DB_POOL_TIMEOUT=60
# DB_POOL_RECYCLE=3600
# DB_ECHO=false
# ENVIRONMENT=production
# LOG_LEVEL=WARNING
# AUDIT_LOG_LEVEL=INFO

# Example: PostgreSQL Docker Compose Configuration
# POSTGRES_PASSWORD must be set to a strong value. If it is missing, Docker Compose
# silently falls back to "changeme". Generate one with: openssl rand -hex 24
# (hex avoids characters that need escaping in a connection URL). Compose builds
# DATABASE_URL from it, so you do not set DATABASE_URL yourself for the compose stack.
# Postgres only reads it when it first creates the data volume; to change it on an
# existing database see docs/DEPLOYMENT.md, "Changing the Database Password".
# POSTGRES_PASSWORD=<output of openssl rand -hex 24>
# PROMPTVAULT_DATA_DIR=/app/data
# DB_POOL_SIZE=20
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=3600
# DB_ECHO=false

# =============================================================================
# Vite Assets Configuration
# =============================================================================

# Enable Vite assets loading (required for CSS to be served from compiled assets)
# Set to 'true' to load CSS and other assets from the Vite build output
USE_VITE_ASSETS=false

# Public URL of the statically built documentation portal. Local development
# defaults to http://localhost:7876 when this is not set. With docker-compose the
# `docs` service serves the portal on port 7876 and this value is baked into the
# web image at build time (rebuild `web` after changing it).
# VITE_DOCS_PORTAL_URL=https://docs.example.com

# =============================================================================
# Example Configurations
# =============================================================================

# Example: SQLite Testing Configuration
# DATABASE_URL=sqlite:///./data/test_promptvault.db
# DB_ECHO=true
# ENVIRONMENT=testing
# LOG_LEVEL=DEBUG
