{
  "name": "promptvault",
  "version": "1.7.0",
  "description": "<h1 align=\"center\">   <a href=\"https://codeberg.org/medenor/promptvault\">     <img src=\"docs/images/promptvault_logo.jpg\" alt=\"Logo\" width=\"250\" height=\"250\">   </a> </h1>",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "dependencies": {
    "codex": "^0.2.3",
    "i18next": "^23.7.6",
    "i18next-browser-languagedetector": "^7.2.0",
    "i18next-http-backend": "^2.4.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitest/coverage-v8": "^2.1.9",
    "@vitest/ui": "^2.1.3",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jsdom": "^25.0.1",
    "playwright": "^1.58.0",
    "postcss": "^8.5.6",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^2.1.3"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:ui": "playwright test scripts/playwright_auth_ui_tests.ts --ui",
    "test:ui:accessibility": "playwright test scripts/playwright_accessibility_tests.ts --project=chromium",
    "test:ui:accessibility:all": "playwright test scripts/playwright_accessibility_tests.ts",
    "test:ui:headed": "HEADED=1 playwright test scripts/playwright_auth_ui_tests.ts",
    "test:ui:debug": "DEBUG=1 playwright test scripts/playwright_auth_ui_tests.ts --debug",
    "test:ui:all": "bash scripts/run_playwright_tests.sh",
    "test:ui:init": "python3 scripts/init_test_admin.py",
    "playwright:install": "playwright install"
  },
  "repository": {
    "type": "git",
    "url": "https://codeberg.org/Medenor/promptvault.git"
  },
  "keywords": [],
  "author": "",
  "license": "MPL-2.0",
  "type": "module"
}
