{
  "name": "promptvault",
  "version": "1.15.0",
  "description": "<h1 align=\"center\">   <a href=\"https://github.com/Medenor/PromptVault\">     <img src=\"docs/images/promptvault_logo.jpg\" alt=\"Logo\" width=\"250\" height=\"250\">   </a> </h1>",
  "main": "index.js",
  "engines": {
    "node": ">=22"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "dependencies": {
    "dotenv": "^17.2.4",
    "i18next": "^23.7.6",
    "i18next-browser-languagedetector": "^7.2.0",
    "i18next-http-backend": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "fake-indexeddb": "^6.2.5",
    "jiti": "^2.7.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.58.0",
    "postcss": "^8.5.6",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.3.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "typecheck:tests:specs": "tsc -p tsconfig.tests.specs.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:ui": "playwright test scripts/playwright_auth_ui_tests.ts --ui",
    "test:a11y": "playwright test tests/accessibility --grep-invert @diagnostic-a11y",
    "test:a11y:canonical": "playwright test tests/accessibility --grep-invert @diagnostic-a11y",
    "test:a11y:hygiene": "node tests/accessibility/scripts/check-spec-hygiene.mjs",
    "test:ui:accessibility": "playwright test scripts/playwright_accessibility_tests.ts --project=chromium",
    "test:ui:accessibility:all": "playwright test scripts/playwright_accessibility_tests.ts",
    "test:ui:focus": "playwright test scripts/playwright_focus_indicators_tests.ts --project=chromium",
    "test:ui:focus:all": "playwright test scripts/playwright_focus_indicators_tests.ts",
    "test:ui:lighthouse": "npx -y @lhci/cli@0.15.1 autorun --config=./lighthouserc.json",
    "test:ui:headed": "HEADED=1 playwright test scripts/playwright_auth_ui_tests.ts",
    "test:ui:debug": "DEBUG=1 playwright test scripts/playwright_auth_ui_tests.ts --debug",
    "test:ui:all": "bash scripts/run_playwright_tests.sh",
    "test:ui:init": "python3 scripts/init_test_admin.py",
    "playwright:install": "playwright install"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Medenor/PromptVault.git"
  },
  "keywords": [],
  "author": "",
  "license": "MPL-2.0",
  "type": "module"
}
