# PromptVault Production Environment Configuration
# This template provides production-ready defaults with strict security settings.
# Generated by setup_env.py for production profile.

# =============================================================================
# Database Configuration
# =============================================================================

# Database connection URL
# Production uses PostgreSQL for performance, reliability, and scalability
# IMPORTANT: Replace with your actual PostgreSQL credentials
DATABASE_URL=postgresql://promptvault_user:CHANGE_THIS_PASSWORD@localhost:5432/promptvault_prod

# PostgreSQL Connection Pool Settings
# Optimized for production workload
DB_POOL_SIZE=30
DB_POOL_TIMEOUT=60
DB_POOL_RECYCLE=3600

# Disable SQL query logging in production for performance and security
DB_ECHO=false

# =============================================================================
# Application Settings
# =============================================================================

# Environment identifier
ENVIRONMENT=production

# Logging level - WARNING to reduce noise in production
# Only warnings, errors, and critical issues will be logged
LOG_LEVEL=WARNING

# Audit log level (for version control and backup operations)
# Keep INFO to maintain audit trail
AUDIT_LOG_LEVEL=INFO

# =============================================================================
# Authentication & Security Configuration
# =============================================================================

# JWT Configuration
# Paths to ES256 keys for signing and verifying tokens
# IMPORTANT: Ensure these keys are generated securely and backed up
JWT_PRIVATE_KEY_PATH=secrets/jwt/private_key.pem
JWT_PUBLIC_KEY_PATH=secrets/jwt/public_key.pem

# JWT token lifetimes (in seconds)
# Access token: 15 minutes (900s) - short-lived for security
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=900

# Refresh token: 7 days (604800s) - balance between security and convenience
JWT_REFRESH_TOKEN_EXPIRE_SECONDS=604800

# JWT token issuer and audience (for token validation)
# IMPORTANT: Customize these for your production deployment
JWT_ISSUER=promptvault
JWT_AUDIENCE=promptvault-api

# =============================================================================
# Password Policy
# =============================================================================

# Strict password requirements for production security
# Minimum password length - 16 characters (more strict than development)
PASSWORD_MIN_LENGTH=16

# Password character requirements - all required for maximum security
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true

# =============================================================================
# Account Security
# =============================================================================

# Maximum failed login attempts before account lockout
# Protects against brute force attacks
MAX_LOGIN_ATTEMPTS=5

# Account lockout duration in seconds (15 minutes = 900s)
ACCOUNT_LOCKOUT_DURATION_SECONDS=900

# Session Management
# Maximum number of active sessions per user (0 = unlimited)
MAX_SESSIONS_PER_USER=5

# Inactive session timeout in seconds (30 days = 2592000s)
SESSION_INACTIVE_TIMEOUT_SECONDS=2592000

# =============================================================================
# Rate Limiting
# =============================================================================

# ENABLE rate limiting for production to protect against abuse
# CRITICAL: Never disable rate limiting in production
DISABLE_RATE_LIMITING=false

# Redis connection URL for rate limiting storage
# IMPORTANT: Replace with your actual Redis instance
REDIS_URL=redis://localhost:6379/0

# Login rate limit: attempts per time window
# Protects against brute force login attacks
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900

# Registration rate limit: attempts per time window
# Prevents spam account creation
RATE_LIMIT_REGISTER_ATTEMPTS=3
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600

# Password reset rate limit: attempts per time window
# Prevents password reset abuse
RATE_LIMIT_PASSWORD_RESET_ATTEMPTS=3
RATE_LIMIT_PASSWORD_RESET_WINDOW_SECONDS=3600

# =============================================================================
# Email Configuration
# =============================================================================

# SMTP server settings for sending emails (password resets, notifications)
# IMPORTANT: Replace with your actual SMTP server credentials
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=CHANGE_THIS_PASSWORD

# Email sender information
# This will appear in the "From" field of emails
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=PromptVault

# Password reset token validity (1 hour = 3600s)
# Shorter validity increases security
PASSWORD_RESET_TOKEN_EXPIRE_SECONDS=3600

# =============================================================================
# Application URLs
# =============================================================================

# Base URL of the application
# IMPORTANT: Replace with your actual production domain
APP_BASE_URL=https://your-domain.com
