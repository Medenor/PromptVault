# PromptVault Development Environment Configuration
# This template provides development-friendly defaults optimized for local development.
# Generated by setup_env.py for development profile.

# =============================================================================
# Database Configuration
# =============================================================================

# Database connection URL
# Development uses SQLite for simplicity and portability
DATABASE_URL=sqlite:///./data/promptvault.db

# PostgreSQL Connection Pool Settings (ignored for SQLite)
# Keeping defaults for potential future use
DB_POOL_SIZE=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Enable SQL query logging for debugging
# Shows all SQL queries in logs - helpful for development
DB_ECHO=true

# =============================================================================
# Application Settings
# =============================================================================

# Environment identifier
ENVIRONMENT=development

# Logging level - DEBUG for maximum visibility during development
LOG_LEVEL=DEBUG

# Audit log level (for version control and backup operations)
AUDIT_LOG_LEVEL=DEBUG

# =============================================================================
# Authentication & Security Configuration
# =============================================================================

# JWT Configuration
# Paths to ES256 keys for signing and verifying tokens
JWT_PRIVATE_KEY_PATH=secrets/jwt/private_key.pem
JWT_PUBLIC_KEY_PATH=secrets/jwt/public_key.pem

# JWT token lifetimes (in seconds)
# Access token: 15 minutes (900s) - standard for development
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=900

# Refresh token: 7 days (604800s) - convenient for local development
JWT_REFRESH_TOKEN_EXPIRE_SECONDS=604800

# JWT token issuer and audience (for token validation)
JWT_ISSUER=promptvault
JWT_AUDIENCE=promptvault-api

# =============================================================================
# Password Policy
# =============================================================================

# Relaxed password requirements for development
# Minimum password length - 12 characters (less strict than production)
PASSWORD_MIN_LENGTH=12

# Password character requirements
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true

# =============================================================================
# Account Security
# =============================================================================

# Maximum failed login attempts before account lockout
MAX_LOGIN_ATTEMPTS=5

# Account lockout duration in seconds (15 minutes = 900s)
ACCOUNT_LOCKOUT_DURATION_SECONDS=900

# Session Management
# Maximum number of active sessions per user (0 = unlimited)
MAX_SESSIONS_PER_USER=5

# Inactive session timeout in seconds (30 days = 2592000s)
SESSION_INACTIVE_TIMEOUT_SECONDS=2592000

# =============================================================================
# Rate Limiting
# =============================================================================

# DISABLE rate limiting for development to avoid interruptions during testing
# This allows unlimited requests without throttling
DISABLE_RATE_LIMITING=true

# Redis connection URL for rate limiting storage
# Not used when DISABLE_RATE_LIMITING=true, but kept for reference
REDIS_URL=redis://localhost:6379/0

# Login rate limit: attempts per time window
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900

# Registration rate limit: attempts per time window
RATE_LIMIT_REGISTER_ATTEMPTS=3
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600

# Password reset rate limit: attempts per time window
RATE_LIMIT_PASSWORD_RESET_ATTEMPTS=3
RATE_LIMIT_PASSWORD_RESET_WINDOW_SECONDS=3600

# =============================================================================
# Email Configuration
# =============================================================================

# Email settings - optional for development
# You can leave these as placeholders unless testing email functionality
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=changeme

# Email sender information
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=PromptVault Development

# Password reset token validity (1 hour = 3600s)
PASSWORD_RESET_TOKEN_EXPIRE_SECONDS=3600

# =============================================================================
# Application URLs
# =============================================================================

# Base URL of the application - default local development URL
APP_BASE_URL=http://localhost:8000
