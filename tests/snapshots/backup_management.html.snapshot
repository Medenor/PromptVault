</div>
<!-- Restore Preview Modal -->
<div id="restore-preview-modal" aria-modal="true" aria-labelledby="restore-preview-title" role="dialog" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50">
<div class="bg-white rounded-lg shadow-xl max-w-2xl w-full mx-4 dark:bg-gray-800">
<div class="flex items-center justify-between p-6 border-b border-gray-200 dark:border-gray-700">
<h2 id="restore-preview-title" class="text-xl font-bold text-gray-900 dark:text-gray-100" data-i18n="backup.restorePreviewTitle">Restore Preview</h2>
<button type="button" class="text-gray-400 hover:text-gray-700 text-2xl cursor-pointer rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 dark:hover:text-gray-300" aria-label="Close modal" data-i18n="[aria-label]actions.close" onclick="hideRestorePreview()">&times;</button>
</div>
<div class="p-6">
<p class="text-gray-700 mb-4 dark:text-gray-300" data-i18n="backup.restorePreviewDescription">Select which prompts to restore:</p>
<div id="restore-preview-content"></div>
<div id="restore-preview-status" class="text-sm mt-4"></div>
</div>
<div class="flex items-center justify-end gap-2 p-6 border-t border-gray-200 dark:border-gray-700">
<button type="button" class="px-4 py-2 text-sm font-medium bg-gray-200 text-gray-900 hover:bg-gray-300 rounded-lg transition dark:bg-gray-700 dark:text-gray-100 dark:hover:bg-gray-600" onclick="hideRestorePreview()" data-i18n="actions.cancel">Cancel</button>
<button type="button" id="confirm-selective-restore-btn" class="px-4 py-2 text-sm font-semibold bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition" data-i18n="backup.restoreSelectedBtn">Restore Selected</button>
</div>
</div>
</div>
<!-- Restore Confirmation Modal -->
<div
id="restore-modal"
aria-modal="true"
aria-labelledby="restore-modal-title"
role="dialog"
class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50"
>
<div class="bg-white rounded-lg shadow-xl max-w-md w-full mx-4 dark:bg-gray-800">
<div class="flex items-center justify-between p-6 border-b border-gray-200 dark:border-gray-700">
<h2 id="restore-modal-title" class="text-xl font-bold text-gray-900 dark:text-gray-100" data-i18n="backup.confirmRestore">
Confirm Restore
</h2>
<button
type="button"
class="text-gray-400 hover:text-gray-700 text-2xl cursor-pointer rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 dark:hover:text-gray-300"
aria-label="Close modal"
data-i18n="[aria-label]actions.close"
onclick="hideRestoreModal()"
>&times;</button>
</div>
<div class="p-6">
<p class="text-gray-700 mb-4 dark:text-gray-300" data-i18n="backup.restoreWarning">
Are you sure you want to restore from this backup? This will replace your current data.
</p>
<div class="bg-gray-50 rounded p-3 text-sm dark:bg-gray-900" id="restore-backup-info"></div>
<div class="hidden mt-4" id="restore-passphrase-container">
<label
for="restore-passphrase"
class="block text-sm font-medium text-gray-700 mb-2 dark:text-gray-300"
data-i18n="backup.restorePassphrase"
>Encryption passphrase</label
>
<input
type="password"
id="restore-passphrase"
data-i18n="[placeholder]backup.restorePassphrasePlaceholder"
aria-describedby="restore-passphrase-error"
class="w-full px-3 py-2 text-sm border border-gray-400 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent placeholder-gray-700 dark:placeholder-gray-400 dark:border-gray-600 text-gray-900 dark:text-gray-100"
/>
<p
class="text-red-600 text-xs mt-1"
id="restore-passphrase-error"
role="alert"
aria-live="assertive"
></p>
</div>
<div
class="hidden text-sm text-blue-600 mt-4"
id="restore-status"
data-i18n="backup.restoreInProgress"
>
Restoring backup...
</div>
</div>
<div
class="flex items-center justify-end gap-2 p-6 border-t border-gray-200 dark:border-gray-700"
>
<button
type="button"
class="px-4 py-2 text-sm font-medium bg-gray-200 text-gray-900 hover:bg-gray-300 rounded-lg transition focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-offset-2 dark:bg-gray-700 dark:text-gray-100 dark:hover:bg-gray-600"
onclick="hideRestoreModal()"
data-i18n="actions.cancel"
>
Cancel
</button>
<button
type="button"
id="confirm-restore-btn"
class="px-4 py-2 text-sm font-semibold bg-red-600 hover:bg-red-700 text-white rounded-lg transition focus:outline-none focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2"
data-i18n="backup.restoreBtn"
>
Restore
</button>
</div>
</div>
</div>
<!-- Delete Confirmation Modal -->
<div
id="delete-modal"
aria-modal="true"
aria-labelledby="delete-modal-title"
role="dialog"
class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50"
>
<div class="bg-white rounded-lg shadow-xl max-w-md w-full mx-4 dark:bg-gray-800">
<div class="flex items-center justify-between p-6 border-b border-gray-200 dark:border-gray-700">
<h2 id="delete-modal-title" class="text-xl font-bold text-gray-900 dark:text-gray-100" data-i18n="backup.confirmDelete">
Confirm Delete
</h2>
<button
type="button"
class="text-gray-400 hover:text-gray-700 text-2xl cursor-pointer rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 dark:hover:text-gray-300"
aria-label="Close modal"
data-i18n="[aria-label]actions.close"
onclick="hideDeleteModal()"
>&times;</button>
</div>
<div class="p-6">
<p class="text-gray-700 mb-4 dark:text-gray-300" data-i18n="backup.deleteWarning">
Are you sure you want to delete this backup? This action cannot be undone.
</p>
<div class="bg-gray-50 rounded p-3 text-sm dark:bg-gray-900" id="delete-backup-info"></div>
</div>
<div
class="flex items-center justify-end gap-2 p-6 border-t border-gray-200 dark:border-gray-700"
>
<button
type="button"
class="px-4 py-2 text-sm font-medium bg-gray-200 text-gray-900 hover:bg-gray-300 rounded-lg transition focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-offset-2 dark:bg-gray-700 dark:text-gray-100 dark:hover:bg-gray-600"
onclick="hideDeleteModal()"
data-i18n="actions.cancel"
>
Cancel
</button>
<button
type="button"
id="confirm-delete-btn"
class="px-4 py-2 text-sm font-semibold bg-red-600 hover:bg-red-700 text-white rounded-lg transition focus:outline-none focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2"
data-i18n="backup.deleteBtn"
>
Delete
</button>
</div>
</div>
</div>
<!-- Delete All Confirmation Modal -->
<div
id="delete-all-modal"
aria-modal="true"
aria-labelledby="delete-all-modal-title"
role="dialog"
class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50"
>
<div class="bg-white rounded-lg shadow-xl max-w-md w-full mx-4 dark:bg-gray-800">
<div class="flex items-center justify-between p-6 border-b border-gray-200 dark:border-gray-700">
<h2 id="delete-all-modal-title" class="text-xl font-bold text-gray-900 dark:text-gray-100" data-i18n="backup.confirmDeleteAll">
Delete All Backups
</h2>
<button
type="button"
class="text-gray-400 hover:text-gray-700 text-2xl cursor-pointer rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 dark:hover:text-gray-300"
aria-label="Close modal"
data-i18n="[aria-label]actions.close"
onclick="hideDeleteAllModal()"
>&times;</button>
</div>
<div class="p-6">
<p class="text-gray-700 dark:text-gray-300" data-i18n="backup.deleteAllWarning">
Are you sure you want to delete all backups? This action cannot be undone.
</p>
</div>
<div class="flex items-center justify-end gap-2 p-6 border-t border-gray-200 dark:border-gray-700">
<button
type="button"
class="px-4 py-2 text-sm font-medium bg-gray-200 text-gray-900 hover:bg-gray-300 rounded-lg transition focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-offset-2 dark:bg-gray-700 dark:text-gray-100 dark:hover:bg-gray-600"
onclick="hideDeleteAllModal()"
data-i18n="actions.cancel"
>
Cancel
</button>
<button
type="button"
class="px-4 py-2 text-sm font-semibold bg-red-600 hover:bg-red-700 text-white rounded-lg transition focus:outline-none focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2"
onclick="confirmDeleteAll()"
data-i18n="backup.deleteAllBtn"
>
Delete All
</button>
</div>
</div>
</div>
<script>window.__AUTH_ENABLED__ = true;</script>
<script type="module" src="/static/dist/js/telemetry.BNEueToC.js"></script>
<script type="module" src="/static/dist/js/globalShortcuts.C9zDFoVF.js"></script>
<script
type="module"
src="/static/dist/js/backupManagement.Cro4MJWw.js"
></script>
</body>
</html>