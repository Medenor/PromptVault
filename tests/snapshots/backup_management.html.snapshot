<!doctype html>
<!-- This Source Code Form is subject to the terms of the Mozilla Public
License, v. 2.0. If a copy of the MPL was not distributed with this
file, You can obtain one at https://mozilla.org/MPL/2.0/. -->
<html lang="en">
<head>
<meta charset="UTF-8" />
<script>
// Dark mode bootstrap (FR-017): runs synchronously before first paint to
// avoid a flash of the wrong theme. Follows the OS prefers-color-scheme;
// no manual toggle is provided in this feature (see spec Assumptions).
(function () {
if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
document.documentElement.classList.add('dark');
}
})();
</script>
<meta name="viewport" content="width=device-width, initial-scale=1.0, interactive-widget=resizes-content" />
<meta name="description" content="Backup Management - Create, restore, and manage database backups of your PromptVault data." />
<title>PromptVault - Backup Management</title>
<link rel="icon" type="image/png" sizes="32x32" href="/static/favicon.png" />
<link rel="manifest" href="/static/manifest.json" />
<link rel="apple-touch-icon" href="/static/images/icons/icon-192.png" />
<meta name="apple-mobile-web-app-title" content="PromptVault" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="default" />
<meta name="theme-color" content="#3B82F6" />
<link rel="stylesheet" href="/static/dist/assets/telemetry.BcVrkOIG.css" />
<script src="https://unpkg.com/i18next@23.7.6/i18next.min.js"></script>
<script src="https://unpkg.com/i18next-browser-languagedetector@7.2.0/i18nextBrowserLanguageDetector.min.js"></script>
<script src="https://unpkg.com/i18next-http-backend@2.4.2/i18nextHttpBackend.min.js"></script>
</head>
<body class="bg-gray-50 min-h-screen dark:bg-gray-900">
<a href="#main-content" class="skip-link" data-i18n="nav.skipToMainContent">Skip to main content</a>
<div class="min-h-screen flex flex-col">
<header class="bg-blue-700 text-white shadow-sm" role="banner" aria-label="Site header">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
<div class="flex items-center justify-between h-16">
<div class="flex items-center gap-4 min-w-0">
<a
href="/"
class="inline-flex flex-shrink-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-blue-700 rounded-lg"
aria-label="PromptVault home"
data-i18n="[aria-label]accessibility.labels.home"
>
<img
src="/static/images/promptvault_logo_frontend.webp"
alt=""
aria-hidden="true"
class="h-14 w-14 border-2 border-gray-400 rounded-lg shadow-lg flex-shrink-0 dark:border-gray-600"
/>
</a>
<div class="text-2xl font-bold truncate">PromptVault</div>
</div>
<nav
role="navigation"
aria-label="Page navigation"
data-i18n="[aria-label]accessibility.labels.pageNavigation"
class="flex items-center gap-2"
>
<div class="hidden md:block">
<select
class="language-selector px-3 py-2 text-sm rounded-md border border-gray-400 bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
aria-label="nav.language"
data-i18n="[aria-label]nav.language"
>
<option value="en">EN</option>
<option value="fr">FR</option>
<option value="es">ES</option>
<option value="de">DE</option>
</select>
</div>
<button
type="button"
onclick="window.location.href = '/'"
class="hidden md:block px-4 py-2 text-sm font-medium rounded-lg bg-gray-200 text-gray-900 hover:bg-gray-300 transition whitespace-nowrap flex-shrink-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-blue-500 dark:bg-gray-700 dark:text-gray-100 dark:hover:bg-gray-600"
data-i18n="nav.backToMain"
>
Back to Main
</button>
<button
type="button"
id="mobile-menu-toggle"
class="md:hidden inline-flex items-center justify-center w-11 h-11 rounded-lg bg-blue-600 text-white hover:bg-blue-700 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-blue-500"
aria-label="Open menu"
aria-haspopup="true"
aria-expanded="false"
aria-controls="mobile-sidebar"
data-i18n="[aria-label]accessibility.labels.openMenu"
>
<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
</svg>
</button>
</nav>
</div>
</div>
</header>
<div
id="sidebar-backdrop"
class="fixed inset-0 bg-black/50 z-40 hidden md:hidden transition-opacity duration-300"
></div>
<aside
id="mobile-sidebar"
class="fixed top-0 left-0 w-64 h-full bg-white dark:bg-gray-800 border-r border-gray-200 dark:border-gray-700 z-50 md:hidden transform -translate-x-full transition-transform duration-300 ease-in-out overflow-y-auto"
role="dialog"
aria-modal="true"
aria-label="Navigation"
>
<div class="p-4">
<div class="flex items-center justify-between mb-4">
<h2 class="text-lg font-bold text-gray-900 dark:text-gray-100" data-i18n="nav.menu">Menu</h2>
<button
type="button"
id="sidebar-close"
class="flex items-center justify-center w-11 h-11 text-gray-700 dark:text-gray-300 hover:text-gray-700 dark:text-gray-300 rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700"
aria-label="Close sidebar"
data-i18n="[aria-label]accessibility.labels.closeSidebar"
>
<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
</svg>
</button>
</div>
<nav
class="mb-6"
role="navigation"
aria-label="Primary actions mobile"
data-i18n="[aria-label]accessibility.labels.primaryActionsMobile"
>
<button
type="button"
onclick="window.location.href = '/'"
class="w-full min-h-[44px] text-left px-4 py-2 text-sm font-semibold rounded-lg text-blue-700 hover:bg-blue-50 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-inset"
data-i18n="nav.home"
>
Homepage
</button>
</nav>
<div class="mt-6 border-t border-gray-200 dark:border-gray-700 pt-4" role="group" aria-labelledby="mobile-drawer-data-heading">
<h3 id="mobile-drawer-data-heading" class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3" data-i18n="nav.data">
Data
</h3>
<div class="space-y-1">
<button
type="button"
onclick="window.location.href = '/import-export'"
class="w-full min-h-[44px] text-left px-4 py-2 text-sm rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:bg-gray-700 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-inset"
data-i18n="nav.importExport"
>
Import/Export
</button>
<button
type="button"
onclick="window.location.href = '/backup-management'"
class="w-full min-h-[44px] text-left px-4 py-2 text-sm rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:bg-gray-700 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-inset"
data-i18n="nav.backupManagement"
>
Backup
</button>
</div>
</div>
<div class="mt-6 border-t border-gray-200 dark:border-gray-700 pt-4" role="group" aria-labelledby="mobile-drawer-manage-heading">
<h3 id="mobile-drawer-manage-heading" class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3" data-i18n="management.manage">
Manage
</h3>
<div class="space-y-1">
<button
type="button"
onclick="window.location.href = '/manage-categories'"
class="w-full min-h-[44px] text-left px-4 py-2 text-sm rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:bg-gray-700 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-inset"
data-i18n="categories.manage"
>
Manage Categories
</button>
<button
type="button"
onclick="window.location.href = '/manage-tags'"
class="w-full min-h-[44px] text-left px-4 py-2 text-sm rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:bg-gray-700 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-inset"
data-i18n="tags.manage"
>
Manage Tags
</button>
</div>
</div>
<div id="mobile-drawer-account-section" class="mt-6 border-t border-gray-200 dark:border-gray-700 pt-4" role="group" aria-labelledby="mobile-drawer-account-heading">
<h3 id="mobile-drawer-account-heading" class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3" data-i18n="nav.account">
Account
</h3>
<div class="space-y-1">
<button
type="button"
onclick="window.location.href = '/auth/profile'"
class="w-full min-h-[44px] text-left px-4 py-2 text-sm rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:bg-gray-700 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-inset"
data-i18n="nav.profile"
>
Profile
</button>
<button
type="button"
id="admin-btn-mobile"
onclick="window.location.href = '/admin/users'"
class="w-full min-h-[44px] text-left px-4 py-2 text-sm rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:bg-gray-700 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-inset"
data-i18n="nav.admin"
style="display: none"
>
Admin
</button>
<button
type="button"
id="logout-btn-mobile"
class="w-full min-h-[44px] text-left px-4 py-2 text-sm rounded-lg text-red-700 hover:bg-red-50 transition-colors font-semibold focus:outline-none focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-inset"
data-i18n="nav.logout"
>
Logout
</button>
</div>
</div>
<div class="mt-6 border-t border-gray-200 dark:border-gray-700 pt-4">
<h3 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3" data-i18n="nav.language">
Language
</h3>
<select
class="language-selector w-full px-4 py-2 text-sm rounded-md border border-gray-400 bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
aria-label="nav.language"
data-i18n="[aria-label]nav.language"
>
<option value="en">EN</option>
<option value="fr">FR</option>
<option value="es">ES</option>
<option value="de">DE</option>
</select>
</div>
</div>
</aside>
<!-- Main Content -->
<main id="main-content" role="main" class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
<h1 class="text-3xl font-bold text-gray-900 mb-2 dark:text-gray-100" data-i18n="backup.title">
Backup Management
</h1>
<!-- Page Header -->
<div class="mb-8">
<p class="text-gray-700 dark:text-gray-300" data-i18n="backup.description">
Manage your data backups with comprehensive backup and restoration capabilities
</p>
</div>
<!-- Create Backup & Backup List -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
<!-- Create Backup Section -->
<div class="bg-white rounded-lg shadow p-6 dark:bg-gray-800">
<h2 class="text-xl font-bold text-gray-900 mb-6 dark:text-gray-100" data-i18n="backup.createTitle">
Create Backup
</h3>
<form id="backup-create-form" class="space-y-4" novalidate>
<div
id="backup-create-error-summary"
class="validation-error-banner"
role="alert"
aria-live="polite"
tabindex="-1"
></div>
<div>
<label
for="backup-name"
class="block text-sm font-medium text-gray-700 mb-2 dark:text-gray-300"
data-i18n="backup.backupName"
>Backup Name (optional)</label
>
<input
type="text"
id="backup-name"
name="backup_name"
data-i18n="[placeholder]backup.backupNamePlaceholder"
maxlength="64"
pattern="[A-Za-z0-9_-]*"
aria-describedby="backup-name-error"
class="w-full px-3 py-2 text-sm border border-gray-400 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent placeholder-gray-700 dark:placeholder-gray-400 disabled:bg-gray-50 disabled:text-gray-700 disabled:cursor-not-allowed dark:border-gray-600 text-gray-900 dark:text-gray-100"
/>
<p
class="text-red-600 text-xs mt-1"
id="backup-name-error"
role="alert"
aria-live="assertive"
></p>
</div>
<div class="hidden" id="backup-create-passphrase-container">
<label
for="backup-create-passphrase"
class="block text-sm font-medium text-gray-700 mb-2 dark:text-gray-300"
data-i18n="backup.createPassphrase"
>Encryption passphrase</label
>
<input
type="password"
id="backup-create-passphrase"
data-i18n="[placeholder]backup.createPassphrasePlaceholder"
aria-describedby="backup-create-passphrase-hint backup-create-passphrase-error"
class="w-full px-3 py-2 text-sm border border-gray-400 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent placeholder-gray-700 dark:placeholder-gray-400 dark:border-gray-600 text-gray-900 dark:text-gray-100"
/>
<p
class="text-gray-500 text-xs mt-1 dark:text-gray-400"
id="backup-create-passphrase-hint"
data-i18n="backup.createPassphraseHint"
>This is never stored, so it's required for every backup you create.</p>
<p
class="text-red-600 text-xs mt-1"
id="backup-create-passphrase-error"
role="alert"
aria-live="assertive"
></p>
</div>
<div>
<label
for="backup-create-cloud-provider"
class="block text-sm font-medium text-gray-700 mb-2 dark:text-gray-300"
data-i18n="backup.createCloudProvider"
>Upload to cloud</label
>
<select
id="backup-create-cloud-provider"
class="w-full px-3 py-2 text-sm border border-gray-400 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-gray-600 text-gray-900 dark:text-gray-100"
>
<option value="" data-i18n="backup.scheduleCloudProviderNone">Local only</option>
</select>
</div>
<div class="border-t pt-4 mt-4">
<div class="flex flex-col sm:flex-row gap-2">
<button
type="button"
aria-label="Create a new backup of your data"
data-i18n-aria-label="backup.createBtnAriaLabel"
class="flex-1 px-4 py-2 text-sm font-semibold bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-offset-2"
onclick="createBackup()"
data-i18n="backup.createBtn"
>
Create Backup
</button>
<button
type="button"
aria-label="Clear the backup form"
data-i18n-aria-label="backup.clearBtnAriaLabel"
class="px-4 py-2 text-sm font-medium bg-gray-200 text-gray-900 hover:bg-gray-300 rounded-lg transition focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-offset-2 dark:bg-gray-700 dark:text-gray-100 dark:hover:bg-gray-600"
onclick="clearBackupForm()"
data-i18n="backup.clearBtn"
>
Clear
</button>
</div>
</div>
<div class="hidden" id="backup-progress">
<div class="h-2 bg-gray-200 rounded overflow-hidden mt-2 dark:bg-gray-700">
<div
class="h-full bg-blue-600 transition-all duration-300"
id="backup-progress-fill"
style="width: 0%"
></div>
</div>
<p id="backup-status" class="text-sm text-blue-600 mt-1"></p>
</div>
</form>
</div>
<!-- Backup List Section -->
<div class="bg-white rounded-lg shadow p-6 dark:bg-gray-800">
<h2 class="text-xl font-bold text-gray-900 mb-6 dark:text-gray-100" data-i18n="backup.listTitle">
Available Backups
</h3>
<div class="space-y-3 max-h-96 overflow-y-auto" id="backup-list">
<div class="text-gray-700 text-sm dark:text-gray-300" data-i18n="messages.loading">
Loading backups...
</div>
</div>
<div class="mt-6 flex gap-2">
<button
type="button"
aria-label="Refresh the list of available backups"
data-i18n-aria-label="backup.refreshBtnAriaLabel"
class="flex-1 px-4 py-2 text-sm font-medium bg-gray-200 text-gray-900 hover:bg-gray-300 rounded-lg transition focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-offset-2 dark:bg-gray-700 dark:text-gray-100 dark:hover:bg-gray-600"
onclick="refreshBackups()"
data-i18n="actions.refresh"
>
Refresh
</button>
<button
type="button"
aria-label="Delete all backups"
data-i18n-aria-label="backup.deleteAllBtnAriaLabel"
class="px-4 py-2 text-sm font-medium bg-red-100 text-red-700 hover:bg-red-200 rounded-lg transition focus:outline-none focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2"
onclick="showDeleteAllModal()"
data-i18n="backup.deleteAllBtn"
>
Delete All
</button>
</div>
</div>
</div>
<!-- Maintenance Section -->
<div class="bg-white rounded-lg shadow p-6 mb-8 dark:bg-gray-800">
<h2 class="text-xl font-bold text-gray-900 mb-6 dark:text-gray-100" data-i18n="backup.maintenanceTitle">
Maintenance
</h3>
<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
<div>
<h3 class="font-semibold text-gray-900 mb-4 dark:text-gray-100" data-i18n="backup.cleanupTitle">
Cleanup Old Backups
</h4>
<div class="space-y-4">
<div
id="cleanup-error-summary"
class="validation-error-banner"
role="alert"
aria-live="polite"
tabindex="-1"
></div>
<div>
<label
for="cleanup-retention-days"
class="block text-sm font-medium text-gray-700 mb-2 dark:text-gray-300"
data-i18n="backup.retentionDays"
>Keep backups for (days):</label
>
<input
type="number"
id="cleanup-retention-days"
name="retention_days"
value="30"
min="1"
max="3650"
aria-describedby="retention-days-error"
class="w-full px-3 py-2 text-sm border border-gray-400 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent placeholder-gray-700 dark:placeholder-gray-400 disabled:bg-gray-50 disabled:text-gray-700 disabled:cursor-not-allowed dark:border-gray-600 text-gray-900 dark:text-gray-100"
/>
<div
class="text-red-600 text-sm mt-1"
id="retention-days-error"
role="alert"
aria-live="assertive"
></div>
</div>
<button
type="button"
aria-label="Delete old backups based on retention days setting"
data-i18n-aria-label="backup.cleanupBtnAriaLabel"
class="w-full px-4 py-2 text-sm font-semibold bg-amber-700 hover:bg-amber-800 text-white rounded-lg transition focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-600 focus-visible:ring-offset-2"
onclick="cleanupBackups()"
data-i18n="backup.cleanupBtn"
>
Cleanup
</button>
</div>
</div>
<div>
<h3 class="font-semibold text-gray-900 mb-4 dark:text-gray-100" data-i18n="backup.compressTitle">
Compress Old Backups
</h4>
<div class="space-y-4">
<div
id="compress-error-summary"
class="validation-error-banner"
role="alert"
aria-live="polite"
tabindex="-1"
></div>
<div>
<label
for="compress-days"
class="block text-sm font-medium text-gray-700 mb-2 dark:text-gray-300"
data-i18n="backup.compressDays"
>Compress backups older than (days):</label
>
<input
type="number"
id="compress-days"
name="compress_days"
value="7"
min="1"
max="365"
aria-describedby="compress-days-error"
class="w-full px-3 py-2 text-sm border border-gray-400 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent placeholder-gray-700 dark:placeholder-gray-400 disabled:bg-gray-50 disabled:text-gray-700 disabled:cursor-not-allowed dark:border-gray-600 text-gray-900 dark:text-gray-100"
/>
<div
class="text-red-600 text-sm mt-1"
id="compress-days-error"
role="alert"
aria-live="assertive"
></div>
</div>
<button
type="button"
aria-label="Compress old backups older than the specified number of days"
data-i18n-aria-label="backup.compressBtnAriaLabel"
class="w-full px-4 py-2 text-sm font-semibold bg-cyan-700 hover:bg-cyan-800 text-white rounded-lg transition focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-600 focus-visible:ring-offset-2"
onclick="compressBackups()"
data-i18n="backup.compressBtn"
>
Compress
</button>
</div>
</div>
</div>
<div class="hidden mt-6" id="maintenance-progress">
<div class="h-2 bg-gray-200 rounded overflow-hidden dark:bg-gray-700">
<div
class="h-full bg-blue-600 transition-all duration-300"
id="maintenance-progress-fill"
style="width: 0%"
></div>
</div>
<div id="maintenance-status" class="text-sm text-blue-600 mt-2"></div>
</div>
</div>
<!-- Schedule Section -->
<div class="bg-white rounded-lg shadow p-6 mb-8 dark:bg-gray-800">
<h2 class="text-xl font-bold text-gray-900 mb-6 dark:text-gray-100" data-i18n="backup.scheduleTitle">
Scheduled Backups
</h2>
<form id="schedule-form" class="space-y-4" novalidate>
<div class="flex items-center gap-3">
<label for="schedule-enabled" class="text-sm font-medium text-gray-700 dark:text-gray-300" data-i18n="backup.scheduleEnabled">Enable scheduled backups</label>
<input type="checkbox" id="schedule-enabled" class="h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500 dark:border-gray-600 text-gray-900 dark:text-gray-100" />
</div>
<p class="text-sm text-amber-700 bg-amber-50 border border-amber-200 rounded-md px-3 py-2" data-i18n="backup.scheduleEncryptionNotice">
Scheduled backups are never encrypted, even if encryption is enabled below, because there is no way to prompt for a passphrase in the background. Encryption only applies to backups you create manually.
</p>
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
<div>
<label for="schedule-frequency" class="block text-sm font-medium text-gray-700 mb-1 dark:text-gray-300" data-i18n="backup.scheduleFrequency">Frequency</label>
<select id="schedule-frequency" class="w-full px-3 py-2 text-sm border border-gray-400 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-gray-600 text-gray-900 dark:text-gray-100">
<option value="daily" data-i18n="backup.scheduleFrequencyDaily">Daily</option>
<option value="weekly" data-i18n="backup.scheduleFrequencyWeekly">Weekly</option>
<option value="monthly" data-i18n="backup.scheduleFrequencyMonthly">Monthly</option>
</select>
</div>
<div>
<label for="schedule-hour" class="block text-sm font-medium text-gray-700 mb-1 dark:text-gray-300" data-i18n="backup.scheduleHour">Hour (UTC)</label>
<input type="number" id="schedule-hour" min="0" max="23" value="2" class="w-full px-3 py-2 text-sm border border-gray-400 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-gray-600 text-gray-900 dark:text-gray-100" />
</div>
<div>
<label for="schedule-minute" class="block text-sm font-medium text-gray-700 mb-1 dark:text-gray-300" data-i18n="backup.scheduleMinute">Minute</label>
<input type="number" id="schedule-minute" min="0" max="59" value="0" class="w-full px-3 py-2 text-sm border border-gray-400 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-gray-600 text-gray-900 dark:text-gray-100" />
</div>
<div id="schedule-day-container" class="hidden">
<label for="schedule-day" id="schedule-day-label" class="block text-sm font-medium text-gray-700 mb-1 dark:text-gray-300" data-i18n="backup.scheduleDay">Day</label>
<input type="number" id="schedule-day" min="0" max="31" value="0" class="w-full px-3 py-2 text-sm border border-gray-400 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-gray-600 text-gray-900 dark:text-gray-100" />
</div>
<div>
<label for="schedule-cloud-provider" class="block text-sm font-medium text-gray-700 mb-1 dark:text-gray-300" data-i18n="backup.scheduleCloudProvider">Also upload to cloud</label>
<select id="schedule-cloud-provider" class="w-full px-3 py-2 text-sm border border-gray-400 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-gray-600 text-gray-900 dark:text-gray-100">
<option value="" data-i18n="backup.scheduleCloudProviderNone">None (local backup only)</option>
</select>
</div>
</div>
<div id="schedule-last-run" class="text-sm text-gray-500 hidden dark:text-gray-400"></div>
<div class="flex gap-2">
<button type="button" class="px-4 py-2 text-sm font-semibold bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-offset-2" onclick="saveSchedule()" data-i18n="backup.saveScheduleBtn">
Save Schedule
</button>
</div>
<div id="schedule-status" class="text-sm mt-2"></div>
</form>
</div>
<!-- Encryption Section -->
<div class="bg-white rounded-lg shadow p-6 mb-8 dark:bg-gray-800">
<h2 class="text-xl font-bold text-gray-900 mb-6 dark:text-gray-100" data-i18n="backup.encryptionTitle">
Backup Encryption
</h2>
<form id="encryption-form" class="space-y-4" novalidate>
<div class="flex items-center gap-3">
<label for="encryption-enabled" class="text-sm font-medium text-gray-700 dark:text-gray-300" data-i18n="backup.encryptionEnabled">Enable encryption for new backups</label>
<input type="checkbox" id="encryption-enabled" class="h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500 dark:border-gray-600 text-gray-900 dark:text-gray-100" />
</div>
<div id="encryption-passphrase-container">
<label for="encryption-passphrase" class="block text-sm font-medium text-gray-700 mb-1 dark:text-gray-300" data-i18n="backup.encryptionPassphrase">Passphrase</label>
<input type="password" id="encryption-passphrase" class="w-full px-3 py-2 text-sm border border-gray-400 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-gray-600 text-gray-900 dark:text-gray-100" />
<p class="text-gray-500 text-xs mt-1 dark:text-gray-400" data-i18n="backup.encryptionPassphraseHint">Sets the passphrase for new backups. It isn't stored — you'll enter it again each time you create a backup.</p>
</div>
<div id="encryption-key-rotation" class="hidden space-y-3 border-t pt-4">
<h3 class="text-sm font-semibold text-gray-700 dark:text-gray-300" data-i18n="backup.encryptionKeyRotation">Key Rotation</h3>
<div>
<label for="encryption-old-passphrase" class="block text-sm font-medium text-gray-700 mb-1 dark:text-gray-300" data-i18n="backup.encryptionOldPassphrase">Old passphrase</label>
<input type="password" id="encryption-old-passphrase" class="w-full px-3 py-2 text-sm border border-gray-400 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-gray-600 text-gray-900 dark:text-gray-100" />
</div>
<div>
<label for="encryption-new-passphrase" class="block text-sm font-medium text-gray-700 mb-1 dark:text-gray-300" data-i18n="backup.encryptionNewPassphrase">New passphrase</label>
<input type="password" id="encryption-new-passphrase" class="w-full px-3 py-2 text-sm border border-gray-400 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-gray-600 text-gray-900 dark:text-gray-100" />
</div>
</div>
<div class="flex gap-2">
<button type="button" class="px-4 py-2 text-sm font-semibold bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition" onclick="saveEncryptionConfig()" data-i18n="actions.save">
Save
</button>
<button type="button" id="encryption-rotate-btn" class="hidden px-4 py-2 text-sm font-medium bg-amber-600 hover:bg-amber-700 text-white rounded-lg transition" onclick="rotateEncryptionKey()" data-i18n="backup.encryptionRotateBtn">
Rotate Key
</button>
</div>
<div id="encryption-status" class="text-sm mt-2"></div>
<div id="encryption-info" class="text-xs text-gray-500 mt-2 dark:text-gray-400"></div>
</form>
</div>
<!-- Cloud Storage Section -->
<div class="bg-white rounded-lg shadow p-6 mb-8 dark:bg-gray-800">
<h2 class="text-xl font-bold text-gray-900 mb-6 dark:text-gray-100" data-i18n="backup.cloudTitle">
Cloud Storage Providers
</h2>
<div id="cloud-providers-list" class="space-y-3 mb-4">
<div class="text-gray-500 text-sm dark:text-gray-400" data-i18n="backup.cloudLoadingProviders">Loading providers...</div>
</div>
<div class="border-t pt-4 space-y-3">
<h3 class="text-sm font-semibold text-gray-700 dark:text-gray-300" data-i18n="backup.cloudAddProvider">Add Provider</h3>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
<div>
<label for="provider-name" class="block text-sm font-medium text-gray-700 mb-1 dark:text-gray-300" data-i18n="backup.cloudProviderName">Name</label>
<input type="text" id="provider-name" class="w-full px-3 py-2 text-sm border border-gray-400 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-gray-600 text-gray-900 dark:text-gray-100" />
</div>
<div>
<label for="provider-endpoint" class="block text-sm font-medium text-gray-700 mb-1 dark:text-gray-300" data-i18n="backup.cloudProviderEndpoint">Endpoint URL (optional)</label>
<input type="text" id="provider-endpoint" placeholder="http://minio:9000" class="w-full px-3 py-2 text-sm border border-gray-400 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-gray-600 text-gray-900 dark:text-gray-100" />
</div>
<div>
<label for="provider-bucket" class="block text-sm font-medium text-gray-700 mb-1 dark:text-gray-300" data-i18n="backup.cloudProviderBucket">Bucket Name</label>
<input type="text" id="provider-bucket" class="w-full px-3 py-2 text-sm border border-gray-400 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-gray-600 text-gray-900 dark:text-gray-100" />
</div>
<div>
<label for="provider-region" class="block text-sm font-medium text-gray-700 mb-1 dark:text-gray-300" data-i18n="backup.cloudProviderRegion">Region (optional)</label>
<input type="text" id="provider-region" class="w-full px-3 py-2 text-sm border border-gray-400 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-gray-600 text-gray-900 dark:text-gray-100" />
</div>
<div>
<label for="provider-access-key" class="block text-sm font-medium text-gray-700 mb-1 dark:text-gray-300" data-i18n="backup.cloudProviderAccessKey">Access Key</label>
<input type="text" id="provider-access-key" class="w-full px-3 py-2 text-sm border border-gray-400 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-gray-600 text-gray-900 dark:text-gray-100" />
</div>
<div>
<label for="provider-secret-key" class="block text-sm font-medium text-gray-700 mb-1 dark:text-gray-300" data-i18n="backup.cloudProviderSecretKey">Secret Key</label>
<input type="password" id="provider-secret-key" class="w-full px-3 py-2 text-sm border border-gray-400 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-gray-600 text-gray-900 dark:text-gray-100" />
</div>
</div>
<div class="flex gap-2">
<button type="button" class="px-4 py-2 text-sm font-semibold bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition" onclick="addCloudProvider()" data-i18n="backup.cloudAddProviderBtn">
Add Provider
</button>
</div>
<div id="cloud-status" class="text-sm mt-2"></div>
</div>
</div>
<!-- Statistics Panel (merged Backup Statistics + Monitoring & Audit) -->
<div class="bg-white rounded-lg shadow p-6 dark:bg-gray-800">
<h2 class="text-xl font-bold text-gray-900 mb-6 dark:text-gray-100" data-i18n="backup.statisticsTitle">
Backup Statistics
</h2>
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
<div class="text-center p-3 bg-gray-50 rounded-lg dark:bg-gray-900">
<div class="text-2xl font-bold text-gray-900 dark:text-gray-100" id="monitoring-total-backups">-</div>
<div class="text-xs text-gray-600 dark:text-gray-400" data-i18n="backup.totalBackups">Total Backups</div>
</div>
<div class="text-center p-3 bg-gray-50 rounded-lg dark:bg-gray-900">
<div class="text-2xl font-bold text-blue-600" id="monitoring-total-size">-</div>
<div class="text-xs text-gray-600 dark:text-gray-400" data-i18n="backup.totalSize">Total Size</div>
</div>
<div class="text-center p-3 bg-gray-50 rounded-lg dark:bg-gray-900">
<div class="text-2xl font-bold text-green-600" id="compressed-count">-</div>
<div class="text-xs text-gray-600 dark:text-gray-400" data-i18n="backup.compressedCount">Compressed</div>
</div>
<div class="text-center p-3 bg-gray-50 rounded-lg dark:bg-gray-900">
<div class="text-2xl font-bold text-green-600" id="monitoring-success-rate">-</div>
<div class="text-xs text-gray-600 dark:text-gray-400" data-i18n="backup.monitoringSuccessRate">Success Rate (30d)</div>
</div>
</div>
<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
<div class="text-center p-3 bg-gray-50 rounded-lg dark:bg-gray-900">
<div class="text-sm font-medium text-gray-900 dark:text-gray-100" id="monitoring-last-backup">-</div>
<div class="text-xs text-gray-600 dark:text-gray-400" data-i18n="backup.monitoringLastBackup">Last Backup</div>
</div>
<div class="text-center p-3 bg-gray-50 rounded-lg dark:bg-gray-900">
<div class="text-sm font-medium text-gray-900 dark:text-gray-100" id="newest-backup">-</div>
<div class="text-xs text-gray-600 dark:text-gray-400" data-i18n="backup.newestBackup">Newest Backup</div>
</div>
<div class="text-center p-3 bg-gray-50 rounded-lg dark:bg-gray-900">
<div class="text-sm font-medium text-gray-900 dark:text-gray-100" id="oldest-backup">-</div>
<div class="text-xs text-gray-600 dark:text-gray-400" data-i18n="backup.oldestBackup">Oldest Backup</div>
</div>
</div>
<div id="monitoring-quota-warning" class="mb-4"></div>
<h3 class="font-semibold text-gray-900 mb-3 dark:text-gray-100" data-i18n="backup.monitoringHistory">Backup History (30 days)</h3>
<div id="monitoring-history" class="mb-6"></div>
<h3 class="font-semibold text-gray-900 mb-3 dark:text-gray-100" data-i18n="backup.monitoringAuditLog">Audit Log</h3>
<div id="audit-log-table"></div>
</div>
</main>
<footer
role="contentinfo"
aria-label="Site footer"
class="mt-auto border-t border-gray-200 bg-gray-50 dark:bg-gray-900 dark:border-gray-700"
>
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
<div class="flex flex-col gap-3 text-sm text-gray-600 dark:text-gray-400">
<p>
PromptVault is licensed under
<a
href="https://www.mozilla.org/en-US/MPL/2.0/"
class="text-blue-600 hover:text-blue-800 underline"
target="_blank"
rel="noopener noreferrer"
>Mozilla Public License 2.0</a
>.
</p>
<a
href="https://codeberg.org/medenor/promptvault"
class="inline-flex items-center gap-2 text-blue-600 hover:text-blue-800 transition"
target="_blank"
rel="noopener noreferrer"
aria-label="PromptVault on Codeberg"
>
