<input type="checkbox" id="select-all-checkbox-mobile" class="rounded text-blue-500 focus:ring-blue-500" />
<span data-i18n="actions.selectAll">Select All</span>
</label>
<!-- Clear All Filters Button -->
<button
type="button"
id="clear-all-filters-btn-mobile"
class="w-full px-3 py-2 text-sm font-medium rounded-lg bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:bg-gray-700 transition-all hidden"
data-i18n="nav.clearFilters"
>
Clear All Filters
</button>
</div>
<!-- Categories Section -->
<div class="mb-6">
