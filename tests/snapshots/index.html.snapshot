<!-- Search Input -->
<div class="relative mb-3">
<input
type="text"
id="search-input-mobile"
name="search_input_mobile"
placeholder="Search prompts..."
aria-label="Search prompts"
data-i18n="[aria-label]nav.searchPlaceholder"
data-i18n-placeholder="nav.searchPlaceholder"
class="w-full pl-3 pr-10 py-2 text-sm border border-gray-400 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent placeholder-gray-700 dark:placeholder-gray-400 disabled:bg-gray-50 dark:bg-gray-900 disabled:text-gray-700 dark:text-gray-300 disabled:cursor-not-allowed text-gray-900 dark:text-gray-100"
/>
<svg class="search-input-icon absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none w-5 h-5 transition-colors"
fill="none"
stroke="currentColor"
viewBox="0 0 24 24"
aria-hidden="true"
focusable="false">
<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
</svg>
<button
type="button"
id="search-input-mobile-clear"
class="hidden absolute right-2 top-1/2 -translate-y-1/2 p-1 text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
aria-label="Clear search"
data-i18n="[aria-label]actions.clearSearch"
>
<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
</svg>
</button>
</div>
<!-- Case Sensitive Toggle -->
<label for="case-sensitive-toggle-mobile" class="flex items-center gap-2 mb-2 cursor-pointer text-sm text-gray-700 dark:text-gray-300">
<input type="checkbox" id="case-sensitive-toggle-mobile" class="rounded text-blue-500 focus:ring-blue-500" />
<span data-i18n="nav.caseSensitive">Case Sensitive</span>
</label>
<!-- Favorites Filter -->
<label for="favorites-filter-mobile" class="flex items-center gap-2 mb-3 cursor-pointer text-sm text-gray-700 dark:text-gray-300">
<input type="checkbox" id="favorites-filter-mobile" class="rounded text-blue-500 focus:ring-blue-500" />
<span data-i18n="nav.showFavorites">Show Favorites</span>
</label>
<!-- Shared with me Filter (007-prompt-sharing, US2; hidden in anonymous mode by hideAuthOnlyElements) -->
<label id="shared-with-me-filter-label-mobile" for="shared-with-me-filter-mobile" class="flex items-center gap-2 mb-3 cursor-pointer text-sm text-gray-700 dark:text-gray-300">
<input type="checkbox" id="shared-with-me-filter-mobile" class="rounded text-blue-500 focus:ring-blue-500" />
<span data-i18n="sharing.shared_with_me">Shared with me</span>
</label>
