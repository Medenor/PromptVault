<!-- Mobile Full-Screen Search Overlay (FR-016) -->
<div
id="mobile-search-overlay"
class="hidden fixed inset-0 bg-white dark:bg-gray-900 z-50 md:hidden flex flex-col"
role="dialog"
aria-modal="true"
aria-label="Search prompts"
>
<div class="flex items-center gap-2 p-4 border-b border-gray-200 dark:border-gray-700">
<div class="relative flex-1">
<input
type="text"
id="search-input-overlay"
name="search_input_overlay"
placeholder="Search prompts..."
aria-label="Search prompts"
data-i18n="[aria-label]nav.searchPlaceholder"
data-i18n-placeholder="nav.searchPlaceholder"
class="w-full pl-3 pr-10 py-3 text-base border border-gray-400 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent placeholder-gray-700 dark:placeholder-gray-400 text-gray-900 dark:text-gray-100"
/>
<svg class="search-input-icon absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none w-5 h-5"
fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
</svg>
<button
type="button"
id="search-input-overlay-clear"
class="hidden absolute right-2 top-1/2 -translate-y-1/2 p-1 text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
aria-label="Clear search"
data-i18n="[aria-label]actions.clearSearch"
>
<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
</svg>
</button>
</div>
<button
type="button"
id="search-overlay-close"
class="flex items-center justify-center w-11 h-11 text-gray-700 dark:text-gray-300 rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700"
aria-label="Close search"
data-i18n="[aria-label]actions.close"
>
<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
</svg>
</button>
</div>
<div id="search-overlay-results-info" class="px-4 py-2 text-sm text-gray-600" role="status" aria-live="polite"></div>
</div>
<!-- Main Content -->
<main id="main-content" role="main" class="flex-1 w-full">
<div class="p-6 max-w-7xl mx-auto">
<!-- Search Results Info -->
<h3 class="sr-only">Search Results</h3>
<div
id="search-results-info"
class="mb-4 px-4 py-3 bg-blue-50 text-blue-800 rounded-lg text-sm hidden"
role="status"
aria-live="polite"
></div>
<!-- Bulk Actions Toolbar -->
<h3 class="sr-only">Bulk Actions</h3>
<div
id="bulk-actions-toolbar"
class="mb-4 p-4 bg-amber-50 border border-amber-200 rounded-lg flex items-center justify-between"
style="display: none"
>
<span id="selected-count" class="text-sm font-semibold text-amber-900">0 selected</span>
<div class="flex gap-2 items-center">
<button
type="button"
id="bulk-delete-btn"
class="px-4 py-2 text-sm font-semibold rounded-lg bg-red-600 text-white hover:bg-red-700 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2"
aria-label="Delete all selected prompts"
data-i18n="[aria-label]actions.bulkDeletePrompts"
>
<span data-i18n="actions.bulkDelete">Delete Selected</span>
</button>
<button
type="button"
id="bulk-tag-btn"
class="px-4 py-2 text-sm font-semibold rounded-lg bg-blue-600 text-white hover:bg-blue-700 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-offset-2"
data-i18n="actions.bulkTag"
>
Tag Selected
</button>
<button
type="button"
id="clear-selection-btn"
class="px-4 py-2 text-sm font-medium rounded-lg bg-gray-200 dark:bg-gray-700 text-gray-900 dark:text-gray-100 hover:bg-gray-300 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-offset-2"
>
<span data-i18n="actions.clearSelection">Clear Selection</span>
</button>
</div>
</div>
<!-- Prompts List Header -->
<div class="flex items-center justify-between mb-4">
<h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">
<span data-i18n="nav.prompts">Prompts</span>
</h1>
<div id="item-type-control" class="flex items-center gap-2 ml-auto mr-4">
<label for="item-type-filter" class="text-sm text-gray-700 dark:text-gray-300" data-i18n="filters.itemType.label">Type</label>
<select
id="item-type-filter"
class="item-type-filter text-sm rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 py-1.5 px-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700"
>
<option value="all" selected data-i18n="filters.itemType.all">All</option>
<option value="prompt" data-i18n="filters.itemType.prompt">Prompts</option>
<option value="skill" data-i18n="filters.itemType.skill">Skills</option>
</select>
</div>
<div id="page-size-control" class="flex items-center gap-2">
<label for="page-size-select" class="text-sm text-gray-700 dark:text-gray-300" data-i18n="nav.perPage">Per page:</label>
<select
id="page-size-select"
class="text-sm rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 py-1.5 px-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700"
>
<option value="25" selected>25</option>
<option value="50">50</option>
<option value="100">100</option>
</select>
</div>
</div>
<!-- Empty State for Prompts -->
<div id="prompts-empty-state" class="hidden text-center p-12 bg-gray-50 dark:bg-gray-900 rounded-lg border border-gray-200 dark:border-gray-700">
<div class="text-5xl text-gray-400 mb-4">📝</div>
<h3 class="sr-only">No prompts available</h3>
<p class="text-xl font-semibold text-gray-700 dark:text-gray-300 mb-2" data-i18n="emptyStates.noPrompts.title">No prompts yet</p>
<p class="text-sm text-gray-700 dark:text-gray-300 mb-6" data-i18n="emptyStates.noPrompts.description">Create your first prompt to get started</p>
<button
type="button"
id="empty-state-new-prompt-btn"
class="px-6 py-3 text-base font-semibold rounded-lg bg-blue-600 text-white hover:bg-blue-700 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-offset-2"
data-i18n="emptyStates.noPrompts.action"
>
Create Prompt
</button>
</div>
<!-- Empty State for Search Results -->
<div id="search-empty-state" class="hidden text-center p-12 bg-gray-50 dark:bg-gray-900 rounded-lg border border-gray-200 dark:border-gray-700">
<div class="text-5xl text-gray-400 mb-4">🔍</div>
<h3 class="sr-only">No search results</h3>
<p class="text-xl font-semibold text-gray-700 dark:text-gray-300 mb-2" data-i18n="emptyStates.noSearchResults.title">No results found</p>
<p class="text-sm text-gray-700 dark:text-gray-300 mb-6" data-i18n="emptyStates.noSearchResults.description">Try adjusting your search or filters</p>
<button
type="button"
id="empty-state-clear-filters-btn"
class="px-6 py-3 text-base font-semibold rounded-lg bg-gray-200 dark:bg-gray-700 text-gray-900 dark:text-gray-100 hover:bg-gray-300 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-offset-2"
data-i18n="emptyStates.noSearchResults.action"
>
Clear Filters
</button>
</div>
<!-- Pull-to-refresh loading affordance + accessible fallback (FR-008) -->
<div id="pull-refresh-toolbar" class="flex md:hidden items-center justify-between mb-3">
<div
id="pull-refresh-indicator"
class="hidden items-center gap-2 text-sm text-gray-600 dark:text-gray-400"
role="status"
aria-live="polite"
>
<svg class="w-4 h-4 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
</svg>
<span data-i18n="messages.refreshing">Refreshing…</span>
</div>
<button
type="button"
id="refresh-prompts-btn"
class="min-h-[44px] px-3 py-2 text-sm font-medium rounded-lg bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors ml-auto"
aria-label="Refresh prompt list"
data-i18n="[aria-label]actions.refreshPrompts"
>
<span data-i18n="actions.refresh">Refresh</span>
</button>
</div>
<!-- Prompts Grid (populated by JS) -->
<h3 class="sr-only">Prompts List</h3>
<div
id="prompts-list"
class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
>
<!--
Skeleton placeholder: prompts are private until the client-side
/api/auth/me check (checkAdminAccess in index.ts) confirms the
session hasn't been revoked. loadPrompts() replaces this
container's innerHTML once the check passes, so no real prompt
data is rendered here for auth-enabled sessions.
-->
<div id="prompts-skeleton" class="contents" aria-hidden="true">
<div class="rounded-lg border border-gray-200 dark:border-gray-700 p-4 animate-pulse">
<div class="h-5 w-2/3 rounded bg-gray-200 dark:bg-gray-700 mb-4"></div>
<div class="h-4 w-1/3 rounded bg-gray-200 dark:bg-gray-700 mb-3"></div>
<div class="h-3 w-full rounded bg-gray-200 dark:bg-gray-700 mb-2"></div>
<div class="h-3 w-5/6 rounded bg-gray-200 dark:bg-gray-700"></div>
</div>
<div class="rounded-lg border border-gray-200 dark:border-gray-700 p-4 animate-pulse">
<div class="h-5 w-2/3 rounded bg-gray-200 dark:bg-gray-700 mb-4"></div>
<div class="h-4 w-1/3 rounded bg-gray-200 dark:bg-gray-700 mb-3"></div>
<div class="h-3 w-full rounded bg-gray-200 dark:bg-gray-700 mb-2"></div>
<div class="h-3 w-5/6 rounded bg-gray-200 dark:bg-gray-700"></div>
</div>
<div class="rounded-lg border border-gray-200 dark:border-gray-700 p-4 animate-pulse">
<div class="h-5 w-2/3 rounded bg-gray-200 dark:bg-gray-700 mb-4"></div>
<div class="h-4 w-1/3 rounded bg-gray-200 dark:bg-gray-700 mb-3"></div>
<div class="h-3 w-full rounded bg-gray-200 dark:bg-gray-700 mb-2"></div>
<div class="h-3 w-5/6 rounded bg-gray-200 dark:bg-gray-700"></div>
</div>
<div class="rounded-lg border border-gray-200 dark:border-gray-700 p-4 animate-pulse">
<div class="h-5 w-2/3 rounded bg-gray-200 dark:bg-gray-700 mb-4"></div>
<div class="h-4 w-1/3 rounded bg-gray-200 dark:bg-gray-700 mb-3"></div>
<div class="h-3 w-full rounded bg-gray-200 dark:bg-gray-700 mb-2"></div>
<div class="h-3 w-5/6 rounded bg-gray-200 dark:bg-gray-700"></div>
</div>
<div class="rounded-lg border border-gray-200 dark:border-gray-700 p-4 animate-pulse">
<div class="h-5 w-2/3 rounded bg-gray-200 dark:bg-gray-700 mb-4"></div>
<div class="h-4 w-1/3 rounded bg-gray-200 dark:bg-gray-700 mb-3"></div>
<div class="h-3 w-full rounded bg-gray-200 dark:bg-gray-700 mb-2"></div>
<div class="h-3 w-5/6 rounded bg-gray-200 dark:bg-gray-700"></div>
</div>
<div class="rounded-lg border border-gray-200 dark:border-gray-700 p-4 animate-pulse">
<div class="h-5 w-2/3 rounded bg-gray-200 dark:bg-gray-700 mb-4"></div>
<div class="h-4 w-1/3 rounded bg-gray-200 dark:bg-gray-700 mb-3"></div>
<div class="h-3 w-full rounded bg-gray-200 dark:bg-gray-700 mb-2"></div>
<div class="h-3 w-5/6 rounded bg-gray-200 dark:bg-gray-700"></div>
</div>
</div>
</div>
<!-- Load More (pagination) -->
<div id="load-more-container" class="hidden flex justify-center mt-6">
<button
type="button"
id="load-more-btn"
class="px-6 py-2.5 text-sm font-semibold rounded-lg bg-gray-100 text-gray-900 hover:bg-gray-200 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 disabled:opacity-50 disabled:cursor-not-allowed"
aria-live="polite"
>
Load More
</button>
</div>
<!-- Prompt Editor (hidden by default) -->
<div id="prompt-editor" class="hidden">
<div class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 p-6 max-w-4xl mx-auto">
<h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6" data-i18n="prompt.editorTitle">Create/Edit Prompt</h2>
<form id="prompt-form" class="space-y-4" novalidate>
<div
id="validation-error-banner"
class="validation-error-banner"
role="alert"
aria-live="polite"
tabindex="-1"
style="display: none;"
></div>
<!-- Title -->
<div>
<label for="prompt-title" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" data-i18n="form.title">
Title:
</label>
<input
type="text"
id="prompt-title"
name="title"
data-i18n="[placeholder]form.titlePlaceholder"
required
maxlength="200"
aria-required="true"
aria-describedby="prompt-title-counter prompt-title-error"
class="w-full px-3 py-2 text-sm border border-gray-400 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent placeholder-gray-700 dark:placeholder-gray-400 disabled:bg-gray-50 dark:bg-gray-900 disabled:text-gray-700 dark:text-gray-300 disabled:cursor-not-allowed text-gray-900 dark:text-gray-100"
/>
<div class="flex justify-between items-center mt-1">
<div
id="prompt-title-error"
class="validation-error text-xs text-red-600"
role="alert"
aria-live="assertive"
></div>
<div id="prompt-title-counter" class="text-xs text-gray-700 dark:text-gray-300" aria-live="polite"></div>
</div>
</div>
<!-- Content -->
<div>
<label for="prompt-content" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" data-i18n="form.content">
Content:
</label>
<textarea
id="prompt-content"
name="prompt"
rows="10"
required
maxlength="50000"
aria-required="true"
aria-describedby="prompt-content-counter prompt-content-error"
class="w-full px-3 py-2 text-sm border border-gray-400 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent placeholder-gray-700 dark:placeholder-gray-400 disabled:bg-gray-50 dark:bg-gray-900 disabled:text-gray-700 dark:text-gray-300 disabled:cursor-not-allowed font-mono text-gray-900 dark:text-gray-100"
></textarea>
<div class="flex justify-between items-center mt-1">
<div
id="prompt-content-error"
class="validation-error text-xs text-red-600"
role="alert"
aria-live="assertive"
></div>
<div id="prompt-content-counter" class="text-xs text-gray-700 dark:text-gray-300" aria-live="polite"></div>
</div>
</div>
<!-- Category -->
<div>
<label for="prompt-category" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" data-i18n="form.category">
Category:
</label>
<select
id="prompt-category"
name="category"
aria-describedby="prompt-category-error"
class="w-full px-3 py-2 text-sm border border-gray-400 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent disabled:bg-gray-50 dark:bg-gray-900 disabled:text-gray-700 dark:text-gray-300 disabled:cursor-not-allowed text-gray-900 dark:text-gray-100"
>
<option value="">No category</option>
</select>
<div
id="prompt-category-error"
class="validation-error text-xs text-red-600 mt-1"
role="alert"
aria-live="assertive"
></div>
</div>
<!-- Tags -->
<div>
<label for="prompt-tags" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" data-i18n="form.tags">
Tags (comma-separated):
</label>
<div class="relative">
<div
id="tag-chip-input"
class="flex flex-wrap items-center gap-2 w-full px-3 py-2 text-sm border border-gray-400 dark:border-gray-600 rounded-md bg-white dark:bg-gray-800 focus-within:ring-2 focus-within:ring-blue-500 focus-within:border-transparent min-h-[42px]"
>
<div id="tag-chips" class="flex flex-wrap gap-2"></div>
<input
type="text"
id="prompt-tags-input"
data-i18n="[placeholder]form.tagPlaceholder"
autocomplete="off"
aria-describedby="prompt-tags-counter prompt-tags-error prompt-tags-duplicates"
class="flex-1 min-w-[120px] py-1 outline-none bg-transparent placeholder-gray-700 dark:placeholder-gray-400"
/>
</div>
<input type="hidden" id="prompt-tags" name="tags" />
<div
id="tag-autocomplete"
class="hidden absolute z-10 mt-1 w-full bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg shadow-lg max-h-60 overflow-auto"
></div>
</div>
<div class="mt-2">
<button
type="button"
id="suggest-tags-btn"
class="px-4 py-2 text-sm font-medium rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-100 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-offset-2"
data-i18n="actions.suggestTags"
>
Suggest Tags
</button>
</div>
<div class="flex justify-between items-center mt-1">
<div>
<div
id="prompt-tags-duplicates"
class="validation-warning text-xs text-amber-600"
role="status"
aria-live="polite"
></div>
<div
id="prompt-tags-error"
class="validation-error text-xs text-red-600"
role="alert"
aria-live="assertive"
></div>
</div>
<div id="prompt-tags-counter" class="text-xs text-gray-700 dark:text-gray-300" aria-live="polite"></div>
</div>
</div>
<!-- Semantic Version -->
<div class="mt-4">
<label for="semantic-version" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" data-i18n="version.semanticVersion">
Semantic Version:
</label>
<input
type="text"
id="semantic-version"
name="semantic_version"
data-i18n="[placeholder]version.semanticVersionPlaceholder"
placeholder="e.g. 1.0.0"
maxlength="20"
aria-describedby="semantic-version-error"
class="w-full px-3 py-2 text-sm border border-gray-400 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent placeholder-gray-700 dark:placeholder-gray-400 disabled:bg-gray-50 dark:bg-gray-900 disabled:text-gray-700 dark:text-gray-300 disabled:cursor-not-allowed text-gray-900 dark:text-gray-100"
/>
<div
id="semantic-version-error"
class="validation-error text-xs text-red-600 mt-1"
role="alert"
aria-live="assertive"
></div>
</div>
<!-- Commit Message -->
<div class="border-t pt-4 mt-4">
<label for="commit-message" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" data-i18n="version.commitMessage">
Commit Message:
</label>
<input
type="text"
id="commit-message"
name="commit_message"
data-i18n="[placeholder]version.commitMessagePlaceholder"
placeholder="Describe your changes..."
maxlength="500"
aria-describedby="commit-message-counter commit-message-error"
class="w-full px-3 py-2 text-sm border border-gray-400 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent placeholder-gray-700 dark:placeholder-gray-400 disabled:bg-gray-50 dark:bg-gray-900 disabled:text-gray-700 dark:text-gray-300 disabled:cursor-not-allowed text-gray-900 dark:text-gray-100"
/>
<div class="flex justify-between items-center mt-1">
<div
id="commit-message-error"
class="validation-error text-xs text-red-600"
role="alert"
aria-live="assertive"
></div>
<div id="commit-message-counter" class="text-xs text-gray-700 dark:text-gray-300" aria-live="polite"></div>
</div>
</div>
<!-- Actions -->
<div class="flex gap-2 items-center justify-end pt-2">
<button
type="button"
id="cancel-btn-edit-modal"
class="px-4 py-2 text-sm font-medium rounded-lg bg-gray-200 dark:bg-gray-700 text-gray-900 dark:text-gray-100 hover:bg-gray-300 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-offset-2"
data-i18n="actions.cancel"
>
Cancel
</button>
<button
type="submit"
class="px-4 py-2 text-sm font-semibold rounded-lg bg-blue-600 text-white hover:bg-blue-700 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-offset-2"
data-i18n="actions.save"
>
Save
</button>
</div>
</form>
</div>
</div>
</main>
<!-- Floating action button: New Prompt (mobile only, FR-006) -->
<button
type="button"
id="new-prompt-fab"
class="md:hidden fixed bottom-6 right-6 z-40 w-14 h-14 rounded-full bg-blue-600 text-white shadow-lg hover:bg-blue-700 transition-all hover:scale-105 active:scale-95 flex items-center justify-center focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-offset-2"
aria-label="Create new prompt"
data-i18n="[aria-label]actions.newPromptFab"
>
<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
</svg>
</button>
</div>
<footer class="bg-gray-100 dark:bg-gray-700 border-t border-gray-200 dark:border-gray-700 mt-8 py-6 px-4" role="contentinfo" aria-label="Site footer">
<div class="max-w-7xl mx-auto">
<div class="flex flex-col md:flex-row justify-between items-center gap-4">
<p class="text-sm text-gray-700 dark:text-gray-300">PromptVault is licensed under <a href="https://www.mozilla.org/en-US/MPL/2.0/" class="text-blue-600 hover:text-blue-800 underline" target="_blank" rel="noopener noreferrer">Mozilla Public License 2.0</a>.
</p>
<nav class="contents" aria-label="Footer links">
<a href="https://codeberg.org/medenor/promptvault" class="inline-flex items-center gap-2 text-blue-600 hover:text-blue-800 transition" target="_blank" rel="noopener noreferrer" aria-label="PromptVault on Codeberg">
