<!-- Version History Modal -->
<div id="version-history-modal" aria-modal="true" aria-labelledby="version-history-title" role="dialog" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-0 sm:p-4">
<div class="bg-white dark:bg-gray-800 sm:rounded-lg shadow-xl w-full h-full sm:h-auto sm:max-w-4xl sm:max-h-[90vh] flex flex-col">
<div class="flex items-center justify-between p-6 border-b border-gray-200 dark:border-gray-700">
<h2 id="version-history-title" class="text-2xl font-bold text-gray-900 dark:text-gray-100" data-i18n="version.history">Version History</h2>
<button
id="close-version-history-btn"
type="button"
class="text-gray-400 hover:text-gray-700 dark:text-gray-300 text-2xl leading-none rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700"
aria-label="Close modal"
data-i18n="[aria-label]actions.close"
>
&times;
</button>
</div>
<div class="p-6 overflow-auto flex-1">
<div class="mb-4 relative">
<input
type="text"
id="version-search"
name="version_search"
aria-label="Search versions"
data-i18n="[aria-label]version.searchPlaceholder"
placeholder="Search versions..."
data-i18n-placeholder="version.searchPlaceholder"
class="w-full pl-3 pr-10 py-2 text-sm border border-gray-400 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent placeholder-gray-700 dark:placeholder-gray-400 disabled:bg-gray-50 dark:bg-gray-900 disabled:text-gray-700 dark:text-gray-300 disabled:cursor-not-allowed text-gray-900 dark:text-gray-100"
/>
<svg class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none w-5 h-5 transition-colors"
fill="none"
stroke="currentColor"
viewBox="0 0 24 24"
aria-hidden="true"
focusable="false">
<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
</svg>
</div>
<div id="version-list" class="space-y-3 md:space-y-3 [&.carousel-mode>.version-item]:hidden [&.carousel-mode>.version-item.carousel-active]:block">
<div class="text-center text-gray-700 dark:text-gray-300 py-8" data-i18n="messages.loading">Loading...</div>
</div>
<!-- Mobile-only swipeable carousel navigation (FR-018): pages through
one version at a time; visible prev/next buttons are the
accessible equivalent of the swipe gesture. -->
<div id="version-carousel-nav" class="hidden md:hidden items-center justify-between mt-3">
<button
type="button"
id="version-carousel-prev"
class="min-w-[44px] min-h-[44px] flex items-center justify-center rounded-lg bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors disabled:opacity-40 disabled:cursor-not-allowed"
aria-label="Previous version"
data-i18n="[aria-label]version.previousVersion"
>
<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
</svg>
</button>
<span id="version-carousel-position" class="text-sm text-gray-600 dark:text-gray-400" role="status" aria-live="polite"></span>
<button
type="button"
id="version-carousel-next"
class="min-w-[44px] min-h-[44px] flex items-center justify-center rounded-lg bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors disabled:opacity-40 disabled:cursor-not-allowed"
aria-label="Next version"
data-i18n="[aria-label]version.nextVersion"
>
<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
</svg>
</button>
</div>
</div>
<div class="flex items-center justify-end gap-2 p-6 border-t border-gray-200 dark:border-gray-700">
<button
type="button"
id="close-version-history-btn"
class="px-4 py-2 text-sm font-medium rounded-lg bg-gray-200 dark:bg-gray-700 text-gray-900 dark:text-gray-100 hover:bg-gray-300 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-offset-2"
data-i18n="actions.close"
>
Close
</button>
<button
type="button"
id="compare-versions-btn"
class="hidden px-4 py-2 text-sm font-semibold rounded-lg bg-blue-600 text-white hover:bg-blue-700 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-offset-2"
data-i18n="version.compare"
>
Compare Selected
</button>
</div>
</div>
</div>
<!-- Diff Viewer Modal -->
<div id="diff-modal" aria-modal="true" aria-labelledby="diff-modal-title" role="dialog" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-0 sm:p-4">
<div class="bg-white dark:bg-gray-800 sm:rounded-lg shadow-xl w-full h-full sm:h-auto sm:max-w-6xl sm:max-h-[90vh] flex flex-col">
<div class="flex items-center justify-between p-6 border-b border-gray-200 dark:border-gray-700">
<h2 id="diff-modal-title" class="text-2xl font-bold text-gray-900 dark:text-gray-100" data-i18n="version.compareVersions">Compare Versions</h2>
<button
type="button"
onclick="hideDiffModal()"
class="text-gray-400 hover:text-gray-700 dark:text-gray-300 text-2xl leading-none rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700"
aria-label="Close modal"
data-i18n="[aria-label]actions.close"
>
&times;
</button>
</div>
<div class="p-6 overflow-auto flex-1">
<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
<div>
<label for="diff-v1-selector" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2" data-i18n="version.version1">Version 1:</label>
<select
id="diff-v1-selector"
name="diff_v1"
class="w-full px-3 py-2 text-sm border border-gray-400 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent disabled:bg-gray-50 dark:bg-gray-900 disabled:text-gray-700 dark:text-gray-300 disabled:cursor-not-allowed text-gray-900 dark:text-gray-100"
></select>
</div>
<div>
<label for="diff-v2-selector" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2" data-i18n="version.version2">Version 2:</label>
<select
id="diff-v2-selector"
name="diff_v2"
class="w-full px-3 py-2 text-sm border border-gray-400 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent disabled:bg-gray-50 dark:bg-gray-900 disabled:text-gray-700 dark:text-gray-300 disabled:cursor-not-allowed text-gray-900 dark:text-gray-100"
></select>
</div>
</div>
<div id="diff-view" class="bg-gray-50 dark:bg-gray-900 rounded-lg p-4 min-h-[200px] overflow-x-auto" style="touch-action: pan-x pan-y pinch-zoom;">
<div class="text-center text-gray-700 dark:text-gray-300 py-8" data-i18n="messages.loading">Loading...</div>
</div>
</div>
<div class="flex items-center justify-end gap-2 p-6 border-t border-gray-200 dark:border-gray-700">
<button
type="button"
id="close-diff-btn"
class="px-4 py-2 text-sm font-medium rounded-lg bg-gray-200 dark:bg-gray-700 text-gray-900 dark:text-gray-100 hover:bg-gray-300 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-offset-2"
data-i18n="actions.close"
>
Close
</button>
</div>
</div>
</div>
<!-- Revert Confirmation Modal -->
<div id="revert-confirmation-modal" aria-modal="true" aria-labelledby="revert-confirmation-title" role="dialog" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
<div class="bg-white dark:bg-gray-800 rounded-lg shadow-xl max-w-md w-full">
<div class="flex items-center justify-between p-6 border-b border-gray-200 dark:border-gray-700">
<h2 id="revert-confirmation-title" class="text-xl font-bold text-gray-900 dark:text-gray-100" data-i18n="version.confirmRevert">Confirm Revert</h2>
<button
type="button"
onclick="hideRevertConfirmationModal()"
class="text-gray-400 hover:text-gray-700 dark:text-gray-300 text-2xl leading-none rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700"
aria-label="Close modal"
data-i18n="[aria-label]actions.close"
>
&times;
</button>
</div>
<div class="p-6">
<p class="text-sm text-gray-700 dark:text-gray-300 mb-4" data-i18n="version.revertWarning">
Are you sure you want to revert to this version? This will create a new version with the
reverted content.
</p>
<div>
<label for="revert-commit-message" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2" data-i18n="version.commitMessage">
Commit Message:
</label>
<input
type="text"
id="revert-commit-message"
name="revert_commit_message"
placeholder="Describe why you're reverting..."
data-i18n="[placeholder]version.revertMessagePlaceholder"
maxlength="500"
aria-describedby="revert-commit-counter revert-commit-error"
class="w-full px-3 py-2 text-sm border border-gray-400 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent placeholder-gray-700 dark:placeholder-gray-400 disabled:bg-gray-50 dark:bg-gray-900 disabled:text-gray-700 dark:text-gray-300 disabled:cursor-not-allowed text-gray-900 dark:text-gray-100"
/>
<div class="flex justify-between items-center mt-1">
<div
id="revert-commit-error"
class="validation-error text-xs text-red-600"
role="alert"
aria-live="assertive"
></div>
<div id="revert-commit-counter" class="text-xs text-gray-700 dark:text-gray-300" aria-live="polite"></div>
</div>
</div>
</div>
<div class="flex items-center justify-end gap-2 p-6 border-t border-gray-200 dark:border-gray-700">
<button
type="button"
id="cancel-revert-btn"
class="px-4 py-2 text-sm font-medium rounded-lg bg-gray-200 dark:bg-gray-700 text-gray-900 dark:text-gray-100 hover:bg-gray-300 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-offset-2"
data-i18n="actions.cancel"
>
Cancel
</button>
<button
type="button"
id="confirm-revert-btn"
class="px-4 py-2 text-sm font-semibold rounded-lg bg-red-600 text-white hover:bg-red-700 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2"
data-i18n="version.revert"
>
Revert
</button>
</div>
</div>
</div>
<!-- Bulk Delete Confirmation Modal -->
<div id="bulk-delete-modal" aria-modal="true" aria-labelledby="bulk-delete-title" role="dialog" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
<div class="bg-white dark:bg-gray-800 rounded-lg shadow-xl max-w-md w-full">
<div class="flex items-center justify-between p-6 border-b border-gray-200 dark:border-gray-700">
<h2 id="bulk-delete-title" class="text-xl font-bold text-gray-900 dark:text-gray-100" data-i18n="bulkDelete.confirmTitle">Confirm Bulk Deletion</h2>
<button
type="button"
onclick="hideBulkDeleteModal()"
class="text-gray-400 hover:text-gray-700 dark:text-gray-300 text-2xl leading-none rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700"
aria-label="Close modal"
data-i18n="[aria-label]actions.close"
>
&times;
</button>
</div>
<div class="p-6">
<p class="text-sm text-gray-700 dark:text-gray-300 mb-3">
<span data-i18n="bulkDelete.confirmMessage">You are about to delete</span>
<strong id="bulk-delete-count" class="text-red-600">0</strong>
<span data-i18n="bulkDelete.prompts">prompt(s)</span>.
</p>
<p class="text-sm text-amber-700 bg-amber-50 p-3 rounded-lg" data-i18n="bulkDelete.warningMessage">
This action will create an automatic backup, but deletion cannot be undone without
restoring from backup.
</p>
</div>
<div class="flex items-center justify-end gap-2 p-6 border-t border-gray-200 dark:border-gray-700">
<button
type="button"
id="cancel-bulk-delete-btn"
class="px-4 py-2 text-sm font-medium rounded-lg bg-gray-200 dark:bg-gray-700 text-gray-900 dark:text-gray-100 hover:bg-gray-300 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-offset-2"
data-i18n="actions.cancel"
>
Cancel
</button>
<button
type="button"
id="confirm-bulk-delete-btn"
class="px-4 py-2 text-sm font-semibold rounded-lg bg-red-600 text-white hover:bg-red-700 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2"
data-i18n="actions.confirmDelete"
>
Confirm Delete
</button>
</div>
</div>
</div>
<!-- Bulk Tag Update Modal -->
<div id="bulk-tag-modal" aria-modal="true" aria-labelledby="bulk-tag-title" role="dialog" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
<div class="bg-white dark:bg-gray-800 rounded-lg shadow-xl max-w-md w-full">
<div class="flex items-center justify-between p-6 border-b border-gray-200 dark:border-gray-700">
<h2 id="bulk-tag-title" class="text-xl font-bold text-gray-900 dark:text-gray-100" data-i18n="bulkTag.title">Bulk Tag Update</h2>
<button
type="button"
onclick="hideBulkTagModal()"
class="text-gray-400 hover:text-gray-700 dark:text-gray-300 text-2xl leading-none rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700"
aria-label="Close modal"
data-i18n="[aria-label]actions.close"
>
&times;
</button>
</div>
<div class="p-6 space-y-4">
<p class="text-sm text-gray-700 dark:text-gray-300">
<span data-i18n="bulkTag.description">Update tags for</span>
<strong id="bulk-tag-count">0</strong>
<span data-i18n="bulkTag.prompts">prompt(s).</span>
</p>
<div>
<label for="bulk-tag-add" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2" data-i18n="bulkTag.addLabel">Add Tags</label>
<input
id="bulk-tag-add"
type="text"
placeholder="Comma-separated tags"
data-i18n="[placeholder]bulkTag.placeholder"
aria-describedby="bulk-tag-note"
class="w-full px-3 py-2 text-sm border border-gray-400 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent placeholder-gray-700 dark:placeholder-gray-400 disabled:bg-gray-50 dark:bg-gray-900 disabled:text-gray-700 dark:text-gray-300 disabled:cursor-not-allowed text-gray-900 dark:text-gray-100"
/>
</div>
<div>
<label for="bulk-tag-remove" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2" data-i18n="bulkTag.removeLabel">Remove Tags</label>
<input
id="bulk-tag-remove"
type="text"
placeholder="Comma-separated tags"
data-i18n="[placeholder]bulkTag.placeholder"
aria-describedby="bulk-tag-note"
class="w-full px-3 py-2 text-sm border border-gray-400 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent placeholder-gray-700 dark:placeholder-gray-400 disabled:bg-gray-50 dark:bg-gray-900 disabled:text-gray-700 dark:text-gray-300 disabled:cursor-not-allowed text-gray-900 dark:text-gray-100"
/>
</div>
<p id="bulk-tag-note" class="text-xs text-gray-700 dark:text-gray-300" data-i18n="bulkTag.note">
Tags added or removed will apply to all selected prompts.
</p>
</div>
<div class="flex items-center justify-end gap-2 p-6 border-t border-gray-200 dark:border-gray-700">
<button
type="button"
id="cancel-bulk-tag-btn"
class="px-4 py-2 text-sm font-medium rounded-lg bg-gray-200 dark:bg-gray-700 text-gray-900 dark:text-gray-100 hover:bg-gray-300 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-offset-2"
>
Cancel
</button>
<button
type="button"
id="confirm-bulk-tag-btn"
class="px-4 py-2 text-sm font-semibold rounded-lg bg-blue-600 text-white hover:bg-blue-700 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-offset-2"
data-i18n="actions.applyTags"
>
Apply Tags
</button>
</div>
</div>
</div>
<script>window.__AUTH_ENABLED__ = true;</script>
<script type="module" src="/static/dist/js/telemetry.BNEueToC.js"></script>
<script type="module" src="/static/dist/js/globalShortcuts.C9zDFoVF.js"></script>
<script
type="module"
src="/static/dist/js/app.9fa6uA0q.js"
></script>
</body>
</html>