<!doctype html>
<!-- This Source Code Form is subject to the terms of the Mozilla Public
License, v. 2.0. If a copy of the MPL was not distributed with this
file, You can obtain one at https://mozilla.org/MPL/2.0/. -->
<html lang="en">
<head>
<meta charset="UTF-8" />
<script>
// Dark mode bootstrap (FR-017): runs synchronously before first paint to
// avoid a flash of the wrong theme. Follows the OS prefers-color-scheme;
// no manual toggle is provided in this feature (see spec Assumptions).
(function () {
if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
document.documentElement.classList.add('dark');
}
})();
</script>
<meta name="viewport" content="width=device-width, initial-scale=1.0, interactive-widget=resizes-content" />
<meta name="description" content="PromptVault - Organize, manage, and collaborate on AI prompts with version control and team features." />
<title>PromptVault - Home</title>
<link rel="icon" type="image/png" sizes="32x32" href="static/favicon.png" />
<link rel="manifest" href="/static/manifest.json" />
<link rel="apple-touch-icon" href="/static/images/icons/icon-192.png" />
<meta name="apple-mobile-web-app-title" content="PromptVault" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="default" />
<meta name="theme-color" content="#3B82F6" />
<link rel="stylesheet" href="/static/dist/assets/telemetry.BcVrkOIG.css" />
<style>
@keyframes spin {
0% {
transform: rotate(0deg);
}
100% {
transform: rotate(360deg);
}
}
/* Category and Tag list styling */
[id^="categories-list"] li,
[id^="tags-list"] li {
padding: 0.5rem 1rem;
font-size: 0.875rem;
color: #374151;
border-radius: 0.5rem;
cursor: pointer;
border: 1px solid transparent;
transition: all 200ms;
}
.dark [id^="categories-list"] li,
.dark [id^="tags-list"] li {
color: #d1d5db;
}
[id^="categories-list"] li:hover,
[id^="tags-list"] li:hover {
background-color: #f3f4f6;
border-color: #d1d5db;
}
.dark [id^="categories-list"] li:hover,
.dark [id^="tags-list"] li:hover {
background-color: #374151;
border-color: #4b5563;
}
[id^="categories-list"] li:focus-visible,
[id^="tags-list"] li:focus-visible {
outline: 2px solid #3b82f6;
outline-offset: 2px;
background-color: #f3f4f6;
}
.dark [id^="categories-list"] li:focus-visible,
.dark [id^="tags-list"] li:focus-visible {
background-color: #374151;
}
[id^="categories-list"] li.active,
[id^="tags-list"] li.active {
background-color: #eff6ff;
color: #1e40af;
border-color: #93c5fd;
font-weight: 500;
}
.dark [id^="categories-list"] li.active,
.dark [id^="tags-list"] li.active {
background-color: #1e3a8a;
color: #dbeafe;
border-color: #3b82f6;
}
[id^="categories-list"] li.active:hover,
[id^="tags-list"] li.active:hover {
background-color: #dbeafe;
}
.dark [id^="categories-list"] li.active:hover,
.dark [id^="tags-list"] li.active:hover {
background-color: #1e40af;
}
[id^="categories-list"] li.active:focus-visible,
[id^="tags-list"] li.active:focus-visible {
outline: 2px solid #1e40af;
outline-offset: 2px;
}
.dark [id^="categories-list"] li.active:focus-visible,
.dark [id^="tags-list"] li.active:focus-visible {
outline-color: #93c5fd;
}
/* Clear All Filters button - use visibility instead of display for smooth layout */
#clear-all-filters-btn.hidden {
display: block !important;
visibility: hidden !important;
height: 0 !important;
padding: 0 !important;
margin: 0 !important;
pointer-events: none !important;
}
#clear-all-filters-btn:not(.hidden) {
display: block !important;
visibility: visible !important;
height: auto !important;
padding: 0.75rem !important;
margin-top: 0.25rem !important;
pointer-events: auto !important;
}
</style>
<script src="https://cdn.jsdelivr.net/npm/i18next@23.7.6/i18next.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/i18next-browser-languagedetector@7.2.0/i18nextBrowserLanguageDetector.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/i18next-http-backend@2.4.2/i18nextHttpBackend.min.js"></script>
</head>
<body class="bg-gray-50 dark:bg-gray-900">
<a href="#main-content" class="skip-link" data-i18n="nav.skipToMainContent">Skip to main content</a>
<div id="keyboard-navigation-announcer" class="sr-only" aria-live="polite"></div>
<div class="app min-h-screen bg-gray-50 dark:bg-gray-900 flex flex-col">
<!-- Persistent offline indicator (FR-010) -->
<div
id="offline-indicator"
class="hidden bg-amber-100 text-amber-900 text-sm font-medium text-center py-2 px-4 border-b border-amber-300"
role="status"
aria-live="polite"
data-i18n="offline.indicator"
>
You're offline. Viewing cached prompts — changes will sync when you're back online.
</div>
<!-- Header -->
<header class="bg-blue-700 text-white shadow-sm" role="banner" aria-label="Site header">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
<div class="flex items-center justify-between h-16">
<!-- Logo and Title -->
<div class="flex items-center gap-4">
<a
href="/"
class="inline-flex focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-blue-500 rounded-lg"
aria-label="PromptVault home"
data-i18n="[aria-label]accessibility.labels.home"
>
<img
src="/static/images/promptvault_logo_frontend.webp"
alt=""
aria-hidden="true"
class="h-10 w-10 md:h-14 md:w-14 border-2 border-gray-400 dark:border-gray-600 rounded-lg shadow-lg shrink-0"
/>
</a>
<div class="md:max-lg:hidden text-2xl font-bold">PromptVault</div>
</div>
<!-- Actions -->
<nav
class="flex items-center gap-2"
role="navigation"
aria-label="Main navigation"
data-i18n="[aria-label]accessibility.labels.mainNavigation"
>
<!-- Desktop-only: "New" dropdown (New prompt / Import skill) -->
<div class="relative hidden md:block">
<button
type="button"
id="new-menu-btn"
aria-haspopup="menu"
aria-expanded="false"
aria-controls="new-menu"
class="inline-flex items-center gap-1 whitespace-nowrap px-3 py-2 text-sm font-semibold rounded-lg bg-white text-blue-700 border border-blue-200 hover:bg-blue-50 transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-blue-500"
>
<span data-i18n="nav.new">New</span>
<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
</svg>
</button>
<div
id="new-menu"
role="menu"
aria-labelledby="new-menu-btn"
class="hidden absolute left-0 top-full mt-2 min-w-48 z-50 rounded-lg bg-white text-gray-900 shadow-lg border border-gray-200 py-1"
>
<button
type="button"
id="new-prompt-btn"
role="menuitem"
class="block w-full whitespace-nowrap text-left text-gray-900 px-4 py-2 text-sm font-medium hover:bg-blue-50 focus:outline-none focus-visible:bg-blue-50 focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-blue-700"
data-i18n="nav.newPrompt"
>
New Prompt
</button>
<button
type="button"
id="import-skill-btn"
role="menuitem"
class="block w-full whitespace-nowrap text-left text-gray-900 px-4 py-2 text-sm font-medium hover:bg-blue-50 focus:outline-none focus-visible:bg-blue-50 focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-blue-700"
data-i18n="nav.importSkill"
>
Import skill
</button>
</div>
</div>
<!-- Desktop-only buttons -->
<button
type="button"
id="import-export-btn"
onclick="if (window.__requireOnlineNav) { window.__requireOnlineNav('/import-export'); } else { window.location.href = '/import-export'; }"
class="hidden xl:block whitespace-nowrap px-3 py-2 text-sm font-medium rounded-lg bg-gray-200 dark:bg-gray-700 text-gray-900 dark:text-gray-100 hover:bg-gray-300 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-blue-500"
data-i18n="nav.importExport"
>
Import/Export
</button>
<button
type="button"
id="backup-btn"
onclick="if (window.__requireOnlineNav) { window.__requireOnlineNav('/backup-management'); } else { window.location.href = '/backup-management'; }"
class="hidden xl:block whitespace-nowrap px-3 py-2 text-sm font-medium rounded-lg bg-gray-200 dark:bg-gray-700 text-gray-900 dark:text-gray-100 hover:bg-gray-300 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-blue-500"
data-i18n="nav.backupManagement"
>
Backup
</button>
<a
href="http://localhost:7876"
data-docs-portal-link
class="hidden xl:block whitespace-nowrap px-3 py-2 text-sm font-medium rounded-lg bg-gray-200 dark:bg-gray-700 text-gray-900 dark:text-gray-100 hover:bg-gray-300 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-blue-500"
data-i18n="nav.documentation"
>
Documentation
</a>
<!-- md to xl only: secondary links grouped in a "More" dropdown so the header fits on one line -->
<div class="relative hidden md:block xl:hidden">
<button
type="button"
id="more-menu-btn"
aria-haspopup="menu"
aria-expanded="false"
aria-controls="more-menu"
class="inline-flex items-center gap-1 whitespace-nowrap px-3 py-2 text-sm font-medium rounded-lg bg-gray-200 dark:bg-gray-700 text-gray-900 dark:text-gray-100 hover:bg-gray-300 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-blue-500"
>
<span data-i18n="nav.more">More</span>
<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
</svg>
</button>
<div
id="more-menu"
role="menu"
aria-labelledby="more-menu-btn"
class="hidden absolute left-0 top-full mt-2 min-w-48 z-50 rounded-lg bg-white text-gray-900 shadow-lg border border-gray-200 py-1"
>
<button
type="button"
role="menuitem"
onclick="if (window.__requireOnlineNav) { window.__requireOnlineNav('/import-export'); } else { window.location.href = '/import-export'; }"
class="block w-full whitespace-nowrap text-left text-gray-900 px-4 py-2 text-sm font-medium hover:bg-blue-50 focus:outline-none focus-visible:bg-blue-50 focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-blue-700"
data-i18n="nav.importExport"
>
Import/Export
</button>
<button
type="button"
role="menuitem"
onclick="if (window.__requireOnlineNav) { window.__requireOnlineNav('/backup-management'); } else { window.location.href = '/backup-management'; }"
class="block w-full whitespace-nowrap text-left text-gray-900 px-4 py-2 text-sm font-medium hover:bg-blue-50 focus:outline-none focus-visible:bg-blue-50 focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-blue-700"
data-i18n="nav.backupManagement"
>
Backup
</button>
<a
href="http://localhost:7876"
data-docs-portal-link
role="menuitem"
class="block w-full whitespace-nowrap text-left text-gray-900 px-4 py-2 text-sm font-medium hover:bg-blue-50 focus:outline-none focus-visible:bg-blue-50 focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-blue-700"
data-i18n="nav.documentation"
>
Documentation
</a>
</div>
</div>
<div class="hidden md:block">
<select
class="language-selector px-3 py-2 text-sm rounded-md border border-gray-400 bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
aria-label="nav.language"
data-i18n="[aria-label]nav.language"
>
<option value="en">EN</option>
<option value="fr">FR</option>
<option value="es">ES</option>
<option value="de">DE</option>
</select>
</div>
<button
type="button"
id="profile-btn"
onclick="window.location.href = '/auth/profile'"
class="hidden md:block whitespace-nowrap px-3 py-2 text-sm font-medium rounded-lg bg-gray-200 dark:bg-gray-700 text-gray-900 dark:text-gray-100 hover:bg-gray-300 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-blue-500"
data-i18n="nav.profile"
>
Profile
</button>
<button
type="button"
id="admin-btn"
onclick="window.location.href = '/admin/users'"
class="hidden md:block whitespace-nowrap px-3 py-2 text-sm font-medium rounded-lg bg-gray-200 dark:bg-gray-700 text-gray-900 dark:text-gray-100 hover:bg-gray-300 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-blue-500"
data-i18n="nav.admin"
style="display: none"
>
Admin
</button>
<!-- Mobile Search Overlay Trigger -->
<button
type="button"
id="mobile-search-toggle"
class="md:hidden inline-flex items-center justify-center w-11 h-11 rounded-lg bg-blue-600 text-white hover:bg-blue-700 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-blue-500"
aria-label="Search prompts"
aria-haspopup="true"
aria-expanded="false"
aria-controls="mobile-search-overlay"
data-i18n="[aria-label]nav.searchPlaceholder"
>
<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
</svg>
</button>
<!-- Mobile Nav Drawer Trigger (opens the unified #mobile-sidebar drawer) -->
<button
type="button"
id="mobile-menu-toggle"
class="md:hidden inline-flex items-center justify-center w-11 h-11 rounded-lg bg-blue-600 text-white hover:bg-blue-700 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-blue-500"
aria-label="Open menu"
aria-haspopup="true"
aria-expanded="false"
aria-controls="mobile-sidebar"
data-i18n="[aria-label]accessibility.labels.openMenu"
>
<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
</svg>
</button>
<!-- Desktop-only: Logout -->
<button
type="button"
id="logout-btn"
class="hidden md:block whitespace-nowrap px-3 py-2 text-sm font-medium rounded-lg bg-red-600 text-white hover:bg-red-700 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-blue-500"
data-i18n="nav.logout"
>
Logout
</button>
</nav>
</div>
</div>
</header>
<div class="flex">
<!-- Sidebar Backdrop (Mobile Only) -->
<div
id="sidebar-backdrop"
class="fixed inset-0 bg-black/50 z-40 hidden md:hidden transition-opacity duration-300"
></div>
<!-- Desktop Sidebar -->
<aside
class="w-64 bg-white dark:bg-gray-800 border-r border-gray-200 dark:border-gray-700 min-h-[calc(100vh-4rem)] sticky top-0 hidden md:block"
role="complementary"
aria-label="Prompt filters and navigation"
data-i18n="[aria-label]accessibility.labels.promptFiltersNavigation"
>
<div class="p-4">
<h1 class="sr-only">Prompts Dashboard</h1>
<h2 class="text-lg font-bold text-gray-900 dark:text-gray-100 mb-4" data-i18n="nav.filters">Filters</h2>
<!-- Filters Section -->
<div class="mb-6">
<h3 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3" data-i18n="nav.filters">
Filters
</h3>
<!-- Search Input -->
<div class="relative mb-3">
<input
type="text"
id="search-input"
name="search_input"
placeholder="Search prompts..."
aria-label="Search prompts"
data-i18n="[aria-label]nav.searchPlaceholder"
data-i18n-placeholder="nav.searchPlaceholder"
class="w-full pl-3 pr-10 py-2 text-sm border border-gray-400 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent placeholder-gray-700 dark:placeholder-gray-400 disabled:bg-gray-50 dark:bg-gray-900 disabled:text-gray-700 dark:text-gray-300 disabled:cursor-not-allowed text-gray-900 dark:text-gray-100"
/>
<svg class="search-input-icon absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none w-5 h-5 transition-colors"
fill="none"
stroke="currentColor"
viewBox="0 0 24 24"
aria-hidden="true"
focusable="false">
<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
</svg>
<button
type="button"
id="search-input-clear"
class="hidden absolute right-2 top-1/2 -translate-y-1/2 p-1 text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
aria-label="Clear search"
data-i18n="[aria-label]actions.clearSearch"
>
<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
</svg>
</button>
</div>
<!-- Case Sensitive Toggle -->
<label for="case-sensitive-toggle" class="flex items-center gap-2 mb-2 cursor-pointer text-sm text-gray-700 dark:text-gray-300">
<input type="checkbox" id="case-sensitive-toggle" class="rounded text-blue-500 focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" />
<span data-i18n="nav.caseSensitive">Case Sensitive</span>
</label>
<!-- Favorites Filter -->
<label for="favorites-filter" class="flex items-center gap-2 mb-3 cursor-pointer text-sm text-gray-700 dark:text-gray-300">
<input type="checkbox" id="favorites-filter" class="rounded text-blue-500 focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" />
<span data-i18n="nav.showFavorites">Show Favorites</span>
</label>
<!-- Shared with me Filter (007-prompt-sharing, US2; hidden in anonymous mode by hideAuthOnlyElements) -->
<label id="shared-with-me-filter-label" for="shared-with-me-filter" class="flex items-center gap-2 mb-3 cursor-pointer text-sm text-gray-700 dark:text-gray-300">
<input type="checkbox" id="shared-with-me-filter" class="rounded text-blue-500 focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" />
<span data-i18n="sharing.shared_with_me">Shared with me</span>
</label>
<!-- Select All Checkbox -->
<label for="select-all-checkbox" class="flex items-center gap-2 mb-3 cursor-pointer text-sm text-gray-700 dark:text-gray-300">
<input type="checkbox" id="select-all-checkbox" class="rounded text-blue-500 focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" />
<span data-i18n="actions.selectAll">Select All</span>
</label>
<!-- Clear All Filters Button -->
<button
type="button"
id="clear-all-filters-btn"
class="w-full px-4 py-2 text-sm font-medium rounded-lg bg-gray-200 dark:bg-gray-700 text-gray-900 dark:text-gray-100 hover:bg-gray-300 transition hidden focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-offset-2"
data-i18n="nav.clearFilters"
>
Clear All Filters
</button>
</div>
<!-- Categories Section -->
<div class="mb-6">
<h3 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3 flex items-center gap-2">
<svg class="h-4 w-4 text-gray-700 dark:text-gray-300" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false">
<path d="M2.5 4.5c0-1.1.9-2 2-2h2.1c.4 0 .8.2 1.1.4l.8.8c.2.2.5.3.7.3h3.8c1.1 0 2 .9 2 2v5.5c0 1.1-.9 2-2 2h-8.5c-1.1 0-2-.9-2-2v-7z"></path>
</svg>
<span data-i18n="nav.categories">Categories</span>
</h3>
<ul id="categories-list" class="space-y-2 max-h-64 overflow-y-auto text-gray-700 dark:text-gray-300" role="listbox" aria-label="Filter prompts by category">
<li data-category="all" class="active" data-i18n="nav.allCategories" role="option" aria-selected="true" tabindex="0">
All Categories
</li>
</ul>
<!-- Empty State for Categories -->
<div id="categories-sidebar-empty" class="hidden text-center p-4 bg-gray-50 dark:bg-gray-900 rounded-lg border border-gray-200 dark:border-gray-700 mt-2">
<div class="text-2xl text-gray-400 mb-2">📁</div>
<p class="text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1" data-i18n="emptyStates.noCategoriesInSidebar.title">No categories available</p>
<p class="text-xs text-gray-700 dark:text-gray-300" data-i18n="emptyStates.noCategoriesInSidebar.description">Visit Manage Categories to create one</p>
</div>
</div>
<!-- Tags Section -->
<div>
<h3 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3 flex items-center gap-2">
<svg class="h-4 w-4 text-gray-700 dark:text-gray-300" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
<path d="M3.5 7.5L7.5 3.5H12.5V8.5L8.5 12.5L3.5 7.5Z"></path>
<circle cx="10.5" cy="5.5" r="1"></circle>
</svg>
<span data-i18n="nav.tags">Tags</span>
</h3>
<ul id="tags-list" class="space-y-2 max-h-64 overflow-y-auto text-gray-700 dark:text-gray-300" role="listbox" aria-label="Filter prompts by tag">
<li data-tag="all" class="active" data-i18n="nav.allTags" role="option" aria-selected="true" tabindex="0">
All Tags
</li>
</ul>
<!-- Empty State for Tags -->
<div id="tags-sidebar-empty" class="hidden text-center p-4 bg-gray-50 dark:bg-gray-900 rounded-lg border border-gray-200 dark:border-gray-700 mt-2">
<div class="text-2xl text-gray-400 mb-2">🏷️</div>
<p class="text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1" data-i18n="emptyStates.noTagsInSidebar.title">No tags available</p>
<p class="text-xs text-gray-700 dark:text-gray-300" data-i18n="emptyStates.noTagsInSidebar.description">Visit Manage Tags to create one</p>
</div>
</div>
<!-- Management Links -->
<div class="mt-6 border-t border-gray-200 dark:border-gray-700 pt-4">
